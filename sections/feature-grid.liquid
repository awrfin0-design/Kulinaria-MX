{%- liquid
  assign bg = section.settings.background
  assign cols = section.settings.columns
  assign layout = section.settings.layout | default: 'grid'
-%}
<section class="section fg fg--{{ layout }} {% if bg == 'raised' %}section--raised{% elsif bg == 'deep' %}section--deep{% elsif bg == 'walnut' %}surface-walnut{% endif %}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section__head{% if section.settings.center and layout == 'grid' %} section__head--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="lede richtext">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="fg__list{% if layout == 'grid' %} grid grid--{{ cols }}{% endif %}">
      {%- for block in section.blocks -%}
        {%- if layout == 'index' -%}
          {%- assign tag = 'div' -%}
          {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
          <{{ tag }} class="index-row" {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
            <span class="index-row__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="index-row__t">{{ block.settings.title }}</span>
            <p class="index-row__d">{{ block.settings.text | strip_html | truncate: 120 }}</p>
            {%- if tag == 'a' -%}<span class="index-row__a" aria-hidden="true">→</span>{%- else -%}<span></span>{%- endif -%}
          </{{ tag }}>
        {%- else -%}
          {%- assign tag = 'div' -%}
          {%- if block.settings.link != blank and block.settings.link_label == blank -%}{%- assign tag = 'a' -%}{%- endif -%}
          <{{ tag }} class="card{% if block.settings.image != blank %} card--img{% endif %}" style="--i:{{ forloop.index0 }}" {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
              <div class="card__body">
            {%- endif -%}
            {%- if section.settings.numbered or layout == 'stack' -%}<span class="card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{%- endif -%}
            {%- if block.settings.eyebrow != blank -%}<span class="eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
            <h3>{{ block.settings.title }}</h3>
            <div class="richtext text-muted">{{ block.settings.text }}</div>
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <a class="btn btn--ghost" style="margin-top:auto;align-self:flex-start" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
            {%- if block.settings.image != blank -%}</div>{%- endif -%}
          </{{ tag }}>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="fg__foot btn-row" {% if section.settings.center and layout == 'grid' %}style="justify-content:center"{% endif %}>
        <a class="btn btn--gold" href="{{ section.settings.button_link | default: settings.plans_url | default: '/pages/planes' }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cuadrícula de contenido",
  "settings": [
    { "type": "select", "id": "layout", "label": "Diseño", "default": "grid", "options": [
      { "value": "grid", "label": "Cuadrícula de tarjetas" },
      { "value": "stack", "label": "Tarjetas apiladas (se acumulan al hacer scroll)" },
      { "value": "sticky", "label": "Título fijo + tarjetas que avanzan" },
      { "value": "index", "label": "Índice editorial (lista de enlaces)" } ] },
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Título de la sección" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "select", "id": "columns", "label": "Columnas (solo cuadrícula)", "default": "3", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "checkbox", "id": "numbered", "label": "Numerar tarjetas", "default": false },
    { "type": "checkbox", "id": "center", "label": "Centrar encabezado (solo cuadrícula)", "default": false },
    { "type": "select", "id": "background", "label": "Fondo", "default": "base", "options": [
      { "value": "base", "label": "Negro" }, { "value": "raised", "label": "Negro elevado" },
      { "value": "deep", "label": "Negro profundo" }, { "value": "walnut", "label": "Nogal" } ] },
    { "type": "text", "id": "button_label", "label": "Botón al final" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Tarjeta",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen (opcional)" },
        { "type": "text", "id": "eyebrow", "label": "Sobretítulo" },
        { "type": "text", "id": "title", "label": "Título", "default": "Título" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Descripción breve.</p>" },
        { "type": "text", "id": "link_label", "label": "Texto del enlace" },
        { "type": "url", "id": "link", "label": "Enlace", "info": "Sin texto de enlace, toda la tarjeta (o fila) es un enlace." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cuadrícula de contenido",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
