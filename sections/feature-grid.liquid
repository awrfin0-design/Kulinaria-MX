{%- liquid
  assign bg = section.settings.background
  assign cols = section.settings.columns
  assign layout = section.settings.layout | default: 'grid'
-%}
<section class="section fg fg--{{ layout }} {% if bg == 'raised' %}section--raised{% elsif bg == 'deep' %}section--deep{% endif %}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section__head{% if section.settings.center and layout == 'grid' %} section__head--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{% render 'headline', text: section.settings.heading %}</h2>
        {%- if section.settings.text != blank -%}<div class="lede richtext">{{ section.settings.text }}</div>{%- endif -%}
        {%- if layout == 'sticky' and section.settings.button_label != blank -%}
          <div class="btn-row"><a class="arrow-link" href="{{ section.settings.button_link | default: settings.plans_url | default: '/pages/planes' }}"><span class="arrow-link__c">{% render 'icon', name: 'arrow' %}</span>{{ section.settings.button_label }}</a></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="fg__list{% if layout == 'grid' %} grid grid--{{ cols }}{% endif %}">
      {%- for block in section.blocks -%}
        {%- if layout == 'index' -%}
          {%- assign tag = 'div' -%}
          {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
          {%- assign peek = '' -%}
          {%- if block.settings.art != blank and block.settings.art != 'none' -%}{%- assign peek_file = 'photo-' | append: block.settings.art | append: '.webp' -%}{%- assign peek = peek_file | asset_url -%}{%- endif -%}
          <{{ tag }} class="index-row" {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %} {% if peek != blank %}data-peek="{{ peek }}"{% endif %} {{ block.shopify_attributes }}>
            <span class="index-row__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="index-row__t">{{ block.settings.title }}</span>
            <p class="index-row__d">{{ block.settings.text | strip_html | truncate: 120 }}</p>
            {%- if tag == 'a' -%}<span class="index-row__a" aria-hidden="true">→</span>{%- else -%}<span></span>{%- endif -%}
          </{{ tag }}>
        {%- else -%}
          {%- assign tag = 'div' -%}
          {%- if block.settings.link != blank and block.settings.link_label == blank -%}{%- assign tag = 'a' -%}{%- endif -%}
          {%- assign has_photo = false -%}
          {%- assign photo_alt = block.settings.title | escape -%}
          {%- if block.settings.image != blank or block.settings.art != blank and block.settings.art != 'none' -%}{%- assign has_photo = true -%}{%- endif -%}
          <{{ tag }} class="card{% if has_photo %} card--img{% endif %}" style="--i:{{ forloop.index0 }}" {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
            {%- if has_photo -%}
              <span class="card__photo" data-tilt-card>{% render 'photo', image: block.settings.image, art: block.settings.art, alt: photo_alt %}</span>
              <div class="card__body">
            {%- endif -%}
            {%- if section.settings.numbered or layout == 'rows' or layout == 'stack' -%}<span class="card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{%- endif -%}
            {%- if block.settings.eyebrow != blank -%}<span class="eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
            <h3>{{ block.settings.title }}</h3>
            <div class="richtext text-muted">{{ block.settings.text }}</div>
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <a class="text-link" style="margin-top:auto;align-self:flex-start" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
            {%- if has_photo -%}</div>{%- endif -%}
          </{{ tag }}>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank and layout != 'sticky' -%}
      <div class="fg__foot btn-row" {% if section.settings.center and layout == 'grid' %}style="justify-content:center"{% endif %}>
        <a class="arrow-link" href="{{ section.settings.button_link | default: settings.plans_url | default: '/pages/planes' }}"><span class="arrow-link__c">{% render 'icon', name: 'arrow' %}</span>{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cuadrícula de contenido",
  "settings": [
    { "type": "select", "id": "layout", "label": "Diseño", "default": "grid", "options": [
      { "value": "grid", "label": "Cuadrícula de tarjetas" },
      { "value": "rows", "label": "Filas editoriales (número, texto y foto)" },
      { "value": "stack", "label": "Lista apilada con foto lateral" },
      { "value": "sticky", "label": "Título fijo + tarjetas que avanzan" },
      { "value": "index", "label": "Índice editorial (lista de enlaces)" } ] },
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Título de la sección" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "select", "id": "columns", "label": "Columnas (solo cuadrícula)", "default": "3", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "checkbox", "id": "numbered", "label": "Numerar tarjetas", "default": false },
    { "type": "checkbox", "id": "center", "label": "Centrar encabezado (solo cuadrícula)", "default": false },
    { "type": "select", "id": "background", "label": "Fondo", "default": "base", "options": [
      { "value": "base", "label": "Marfil" }, { "value": "raised", "label": "Marfil elevado" },
      { "value": "deep", "label": "Marfil profundo" }, { "value": "walnut", "label": "Nogal" } ] },
    { "type": "text", "id": "button_label", "label": "Botón al final" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Tarjeta",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen (opcional)" },
        { "type": "select", "id": "art", "label": "Foto del tema (si no subes una)", "default": "none", "options": [
          { "value": "none", "label": "Sin foto del tema" }, { "value": "hero", "label": "Corte sobre pizarra" }, { "value": "flames", "label": "Llamas" },
          { "value": "dinner", "label": "Cena a la luz de las velas" }, { "value": "containers", "label": "Envases de vidrio" }, { "value": "wood", "label": "Madera de nogal" },
          { "value": "dish-0", "label": "Platillo 1" }, { "value": "dish-1", "label": "Platillo 2" }, { "value": "dish-2", "label": "Platillo 3" }, { "value": "dish-3", "label": "Platillo 4" },
          { "value": "dish-4", "label": "Platillo 5" }, { "value": "dish-5", "label": "Platillo 6" }, { "value": "dish-6", "label": "Platillo 7" }, { "value": "dish-7", "label": "Platillo 8" } ] },
        { "type": "text", "id": "eyebrow", "label": "Sobretítulo" },
        { "type": "text", "id": "title", "label": "Título", "default": "Título" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Descripción breve.</p>" },
        { "type": "text", "id": "link_label", "label": "Texto del enlace" },
        { "type": "url", "id": "link", "label": "Enlace", "info": "Sin texto de enlace, toda la tarjeta (o fila) es un enlace." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cuadrícula de contenido",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
