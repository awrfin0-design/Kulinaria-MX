{%- capture tx_s_block_cta -%}{% render 'tx', s: section.settings.block_cta %}{%- endcapture -%}
{%- capture tx_s_block_desc -%}{% render 'tx', s: section.settings.block_desc %}{%- endcapture -%}
{%- capture tx_s_block_features -%}{% render 'tx', s: section.settings.block_features %}{%- endcapture -%}
{%- capture tx_s_block_name -%}{% render 'tx', s: section.settings.block_name %}{%- endcapture -%}
{%- capture tx_s_eyebrow -%}{% render 'tx', s: section.settings.eyebrow %}{%- endcapture -%}
{%- capture tx_s_heading -%}{% render 'tx', s: section.settings.heading %}{%- endcapture -%}
{%- capture tx_s_text -%}{% render 'tx', s: section.settings.text %}{%- endcapture -%}
{%- capture tx_s_trial_cta -%}{% render 'tx', s: section.settings.trial_cta %}{%- endcapture -%}
{%- capture tx_s_trial_desc -%}{% render 'tx', s: section.settings.trial_desc %}{%- endcapture -%}
{%- capture tx_s_trial_features -%}{% render 'tx', s: section.settings.trial_features %}{%- endcapture -%}
{%- capture tx_s_trial_name -%}{% render 'tx', s: section.settings.trial_name %}{%- endcapture -%}
{%- liquid
  assign block_features = tx_s_block_features | newline_to_br | split: '<br />'
  assign trial_features = tx_s_trial_features | newline_to_br | split: '<br />'
-%}
<section class="section section--raised" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__head section__head--center">
      {%- if tx_s_eyebrow != blank -%}<span class="eyebrow">{{ tx_s_eyebrow }}</span>{%- endif -%}
      <h2>{% render 'headline', text: tx_s_heading %}</h2>
      <div class="divider-gold"><i></i></div>
      <p class="lede" style="margin-inline:auto">{{ tx_s_text }}</p>
      <p><span class="countdown" data-cutoff>{{ 'cutoff.trial_until' | t }} <strong data-cutoff-value>…</strong></span></p>
    </div>

    <div class="grid grid--2" style="max-width:980px;margin-inline:auto">
      <article class="card plan-card plan-card--featured">
        <span class="plan-card__flag">{{ 'plans.recommended' | t }}</span>
        <span class="eyebrow">{{ tx_s_block_name }}</span>
        <p class="plan-card__price gold-text">{{ 'plans.from' | t }}{% render 'plan-price', tier: 'selecto', kind: 'block', money: true %}<small style="font-size:1rem;font-family:var(--font-body);color:var(--text-muted)"> {{ 'plans.per_block' | t }}</small></p>
        <p class="text-muted">{{ tx_s_block_desc }}</p>
        <ul class="plan-list">{%- for f in block_features -%}{%- if f != blank -%}<li>{{ f }}</li>{%- endif -%}{%- endfor -%}</ul>
        <a class="btn btn--gold btn--block" style="margin-top:auto" href="/pages/pedido?plan=block">{{ tx_s_block_cta }}</a>
      </article>

      <article class="card plan-card">
        <span class="eyebrow">{{ tx_s_trial_name }}</span>
        <p class="plan-card__price">{{ 'plans.from' | t }}{% render 'plan-price', tier: 'selecto', kind: 'week', money: true %}<small style="font-size:1rem;font-family:var(--font-body);color:var(--text-muted)"> {{ 'plans.per_week' | t }}</small></p>
        <p class="text-muted">{{ tx_s_trial_desc }} <strong style="color:var(--accent)">{{ 'plans.week_note' | t }}</strong></p>
        <ul class="plan-list">{%- for f in trial_features -%}{%- if f != blank -%}<li>{{ f }}</li>{%- endif -%}{%- endfor -%}</ul>
        <a class="btn btn--outline btn--block" style="margin-top:auto" href="/pages/pedido?plan=week">{{ tx_s_trial_cta }}</a>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparador de planes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Planes" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige cómo quieres empezar" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "La suscripción se contrata en bloques de 4 semanas. Si prefieres probar, puedes comprar una sola semana." },
    { "type": "header", "content": "Bloque de 4 semanas" },
    { "type": "text", "id": "block_name", "label": "Nombre", "default": "Bloque de 4 semanas" },
    { "type": "textarea", "id": "block_desc", "label": "Descripción", "default": "Suscripción renovable con entrega semanal. Es la opción con mejor precio." },
    { "type": "textarea", "id": "block_features", "label": "Beneficios (uno por línea)", "default": "Precio prorrateado más bajo\nSelección automática si no eliges antes del sábado\nPausas flexibles con saldo a favor\nCódigo de referencia propio y monedero" },
    { "type": "product", "id": "block_product", "label": "Producto de suscripción (con planes de venta)" },
    { "type": "text", "id": "block_cta", "label": "Botón", "default": "Elegir bloque de 4 semanas" },
    { "type": "header", "content": "Semana de prueba" },
    { "type": "text", "id": "trial_name", "label": "Nombre", "default": "Semana de prueba" },
    { "type": "textarea", "id": "trial_desc", "label": "Descripción", "default": "Una sola semana para conocer el servicio." },
    { "type": "textarea", "id": "trial_features", "label": "Beneficios (uno por línea)", "default": "Sin compromiso de renovación\nCompra hasta el sábado 10:00 AM\nPago digital, sin efectivo" },
    { "type": "product", "id": "trial_product", "label": "Producto de la semana de prueba" },
    { "type": "text", "id": "trial_cta", "label": "Botón", "default": "Probar una semana" }
  ],
  "presets": [{ "name": "Comparador de planes" }]
}
{% endschema %}
