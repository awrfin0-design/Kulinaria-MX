{%- liquid
  assign menu = section.settings.menu
-%}
<div class="menu-overlay" id="menu-overlay" role="dialog" aria-modal="true" aria-label="{{ 'nav.overlay_title' | t }}" hidden {{ section.shopify_attributes }}>
  <div class="container menu-overlay__inner">
    <div class="menu-overlay__top">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">{% render 'logo', tone: 'auto' %}</a>
      <div class="menu-overlay__tools">
        {% render 'lang-switcher' %}
        {% render 'theme-toggle' %}
        <a class="icon-link" href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'user' %}</a>
        <a class="icon-link" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">{% render 'icon', name: 'bag' %}</a>
        <button class="icon-link" type="button" data-menu-close aria-label="{{ 'nav.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </div>
    </div>

    <div class="menu-overlay__body">
      <nav class="sitemap" aria-label="{{ 'nav.overlay_title' | t }}">
        {%- if menu != blank -%}
          {%- for link in menu.links -%}
            <div class="sitemap__group" style="--i:{{ forloop.index0 }}">
              <a class="sitemap__top" href="{{ link.url }}"><span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{{ link.title }}</a>
              {%- if link.links.size > 0 -%}
                <ul class="sitemap__sub">
                  {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </nav>

      <div class="menu-overlay__foot">
        <span>
          {%- if settings.contact_email != blank -%}<a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>{%- endif -%}
          {%- if settings.contact_phone != blank %} · <a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone }}</a>{%- endif -%}
        </span>
        {% render 'social-links' %}
        <a class="arrow-link" href="{{ settings.plans_url | default: '/pages/planes' }}"><span class="arrow-link__c">{% render 'icon', name: 'arrow' %}</span>{{ 'nav.cta' | t }}</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Menú (mapa del sitio)",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menú con submenús", "info": "Los enlaces de primer nivel son los títulos; los submenús aparecen debajo.", "default": "main-menu" }
  ]
}
{% endschema %}
