<section class="section section--raised" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="divider-gold"><i></i></div>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="dish-grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'dish-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="dish">
            <div class="dish__media surface-walnut"><span class="dish__ph surface-slate" aria-hidden="true">K</span></div>
            <div class="dish__body">
              <div>{% render 'tier-badge', tier: 'selecto' %}</div>
              <h3 class="dish__title">Platillo de ejemplo {{ i }}</h3>
              <div class="dish__meta"><span class="dish__price">${{ settings.price_selecto }}</span></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="btn-row"><a class="btn btn--outline" href="{{ section.settings.button_link | default: section.settings.collection.url }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Platillos destacados",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Menú de la semana" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Esta semana en Kulinaria" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Un menú rotativo de 8 a 10 platillos. Elige antes del sábado a las 10:00 AM." },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Cantidad", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver el menú completo" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Platillos destacados" }]
}
{% endschema %}
