{%- comment -%} Inner-page header: breadcrumb, title, intro, optional buttons and a sub-navigation to sibling pages. {%- endcomment -%}
<header class="page-head" {{ section.shopify_attributes }}>
  <div class="container">
    <nav class="page-head__crumbs" aria-label="{{ 'nav.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'nav.home' | t }}</a>
      {%- if section.settings.parent_label != blank -%}<i aria-hidden="true">/</i><a href="{{ section.settings.parent_link }}">{{ section.settings.parent_label }}</a>{%- endif -%}
      {%- if section.settings.eyebrow != blank -%}<i aria-hidden="true">/</i><span>{{ section.settings.eyebrow }}</span>{%- endif -%}
    </nav>
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="page-head__cta">
        <a class="arrow-link" href="{{ section.settings.button_link | default: settings.plans_url | default: '/pages/planes' }}"><span class="arrow-link__c">{% render 'icon', name: 'arrow' %}</span>{{ section.settings.button_label }}</a>
        {%- if section.settings.button2_label != blank -%}<a class="text-link" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <nav class="page-head__sub" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link }}" {% if block.settings.link == request.path %}aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</header>

{% schema %}
{
  "name": "Cabecera de página",
  "settings": [
    { "type": "text", "id": "parent_label", "label": "Sección superior (migas de pan)" },
    { "type": "url", "id": "parent_link", "label": "Enlace de la sección superior" },
    { "type": "text", "id": "eyebrow", "label": "Nombre corto de esta página (migas)" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Título de la página" },
    { "type": "textarea", "id": "text", "label": "Introducción" },
    { "type": "text", "id": "button_label", "label": "Botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "text", "id": "button2_label", "label": "Enlace secundario" },
    { "type": "url", "id": "button2_link", "label": "Enlace secundario (URL)" }
  ],
  "blocks": [
    { "type": "link", "name": "Enlace de la subnavegación", "settings": [
      { "type": "text", "id": "label", "label": "Texto", "default": "Subpágina" },
      { "type": "url", "id": "link", "label": "Enlace" } ] }
  ],
  "presets": [{ "name": "Cabecera de página" }]
}
{% endschema %}
