{%- liquid
  assign size = section.settings.size | default: 'full'
  assign art = section.settings.art | default: 'air-steak'
  assign art_m = 'photo-' | append: art | append: '-m.webp'
-%}
<section class="hero hero--{{ size }}" data-scroll data-tilt data-hero {{ section.shopify_attributes }}>
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__slide is-on" data-slide>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', alt: '' }}
      {%- else -%}
        <picture>
          <source media="(max-width: 860px)" srcset="{{ art_m | asset_url }}">
          {% render 'photo', art: art, alt: '', eager: true %}
        </picture>
      {%- endif -%}
    </div>
  </div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="hero__rule" aria-hidden="true"></span>
      <h1>{{ section.settings.heading }}{%- if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em }}</em>{% endif -%}</h1>
      {%- if section.settings.text != blank -%}<p class="hero__sub">{{ section.settings.text }}</p>{%- endif -%}

      {%- if section.settings.show_countdown -%}
        <p><span class="countdown" data-cutoff>{{ 'cutoff.orders_close_in' | t }} <strong data-cutoff-value>…</strong></span></p>
      {%- endif -%}

      <div class="hero__cta">
        {%- if section.settings.button_label != blank -%}
          <a class="arrow-link" href="{{ section.settings.button_link | default: settings.plans_url | default: '/pages/planes' }}"><span class="arrow-link__c">{% render 'icon', name: 'arrow' %}</span>{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="text-link" href="{{ section.settings.button2_link | default: '/collections/menu-semanal' }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
  <span class="hero__scroll" aria-hidden="true"><i></i>{{ 'hero.scroll' | t }}</span>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (parte en tipografía normal)", "default": "Una semana, servida como" },
    { "type": "text", "id": "heading_em", "label": "Título (parte en cursiva de marca)", "default": "una pieza de autor." },
    { "type": "text", "id": "text", "label": "Subtítulo", "default": "Platillos preparados por chefs, adaptados a tu estilo de vida." },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Haz tu pedido" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "button2_label", "label": "Enlace secundario", "default": "Ver el menú de la semana" },
    { "type": "url", "id": "button2_link", "label": "Enlace secundario (URL)" },
    { "type": "checkbox", "id": "show_countdown", "label": "Mostrar cuenta regresiva de cierre", "default": false },
    { "type": "image_picker", "id": "image", "label": "Foto de fondo", "info": "Vacío = foto del tema. Deja el lado izquierdo despejado para el texto." },
    { "type": "select", "id": "art", "label": "Foto del tema", "default": "air-steak", "options": [
      { "value": "air-steak", "label": "Corte en el aire (recomendada)" }, { "value": "air-fish", "label": "Pescado en el aire" } ] }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
