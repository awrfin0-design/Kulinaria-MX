{%- capture tx_s_button2_label -%}{% render 'tx', s: section.settings.button2_label %}{%- endcapture -%}
{%- capture tx_s_button_label -%}{% render 'tx', s: section.settings.button_label %}{%- endcapture -%}
{%- capture tx_s_heading -%}{% render 'tx', s: section.settings.heading %}{%- endcapture -%}
{%- capture tx_s_heading_em -%}{% render 'tx', s: section.settings.heading_em %}{%- endcapture -%}
{%- capture tx_s_text -%}{% render 'tx', s: section.settings.text %}{%- endcapture -%}
{%- liquid
  assign size = section.settings.size | default: 'full'
  assign art = section.settings.art | default: 'air-steak'
  assign art_m = 'photo-' | append: art | append: '-m.webp'
-%}
<section class="hero hero--{{ size }} hero--intro tone-dark" data-scroll data-hero {{ section.shopify_attributes }}>
  {%- if section.blocks.size > 1 -%}
  <div class="hero__cubebox" data-hero-box>
    <div class="hero__cube" data-hero-cube data-interval="{{ section.settings.slide_seconds | default: 4 }}" role="region" aria-roledescription="carousel" aria-label="{{ 'hero.slides' | t }}">
  <div class="container hero__grid hero__face hero__face--intro is-cur" data-hero-intro>
        <div class="hero__stage" aria-hidden="true">
          {%- assign hv_src = section.settings.video_url | default: 'video-hero-intro.mp4' -%}
          {%- if section.settings.video_url == blank -%}{%- assign hv_src = 'video-hero-intro.mp4' | asset_url -%}{%- endif -%}
          <img class="hero__poster" src="{{ 'video-hero-intro-poster.webp' | asset_url }}" width="640" height="640" alt="" fetchpriority="high" decoding="async">
          <video class="hero__video hero__video--intro" muted playsinline preload="none" poster="{{ 'video-hero-intro-poster.webp' | asset_url }}" data-video-src="{{ hv_src }}" data-ambient data-hero-video{% unless section.blocks.size > 1 %} loop{% endunless %}></video>
        </div>
        <div class="hero__copy">
          <span class="hero__rule" aria-hidden="true"></span>
          <h1>{{ tx_s_heading | escape }}{%- if tx_s_heading_em != blank %} <em>{{ tx_s_heading_em | escape }}</em>{% endif -%}</h1>
          {%- if tx_s_text != blank -%}<p class="hero__sub">{{ tx_s_text }}</p>{%- endif -%}
          {% render 'service-badge', class: 'svc-badge--hero' %}
    
          {%- if section.settings.show_countdown -%}
            <p><span class="countdown" data-cutoff>{{ 'cutoff.orders_close_in' | t }} <strong data-cutoff-value>…</strong></span></p>
          {%- endif -%}
    
          <div class="hero__cta">
            {%- if tx_s_button_label != blank -%}
              <a class="arrow-link" href="{{ section.settings.button_link | default: settings.plans_url | default: '/pages/planes' }}" data-order-cta data-returning-label="{{ 'funnel.ret_go' | t }}"><span class="arrow-link__c">{% render 'icon', name: 'arrow' %}</span>{{ tx_s_button_label }}</a>
            {%- endif -%}
            {%- if tx_s_button2_label != blank -%}
              <a class="text-link" href="{{ section.settings.button2_link | default: '/collections/menu-semanal' }}">{{ tx_s_button2_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    
    {%- for block in section.blocks -%}
      {%- capture tx_tag -%}{% render 'tx', s: block.settings.tag %}{%- endcapture -%}
      {%- capture tx_h -%}{% render 'tx', s: block.settings.heading %}{%- endcapture -%}
      {%- capture tx_p -%}{% render 'tx', s: block.settings.text %}{%- endcapture -%}
      {%- capture tx_b -%}{% render 'tx', s: block.settings.button_label %}{%- endcapture -%}
      <article class="hs hero__face container" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ section.blocks.size }}" aria-hidden="true" {{ block.shopify_attributes }}>
        <div class="hs__media">{% render 'photo', image: block.settings.image, art: block.settings.art, alt: '', class: 'hs__img', width: 1000 %}</div>
        <div class="hs__copy">
          {%- if tx_tag != blank -%}<span class="hs__tag">{{ tx_tag }}</span>{%- endif -%}
          <h2>{{ tx_h }}</h2>
          {%- if tx_p != blank -%}<p>{{ tx_p }}</p>{%- endif -%}
          {%- if tx_b != blank -%}<a class="arrow-link" href="{{ block.settings.button_link | default: '/pages/pedido' }}"><span class="arrow-link__c">{% render 'icon', name: 'arrow' %}</span>{{ tx_b }}</a>{%- endif -%}
        </div>
      </article>
    {%- endfor -%}
    </div>
  </div>
  <div class="hero__ctl container" data-hs-ctl>
    <div class="hero__dots" role="group">
      <button class="hero__dot is-on" type="button" data-hs-dot="0" aria-label="{{ 'hero.go' | t | replace: '[n]', 1 }}"><i></i></button>
      {%- for block in section.blocks -%}{%- assign dn = forloop.index | plus: 1 -%}<button class="hero__dot" type="button" data-hs-dot="{{ forloop.index }}" aria-label="{{ 'hero.go' | t | replace: '[n]', dn }}"><i></i></button>{%- endfor -%}
    </div>
  </div>
  {%- else -%}
  <div class="container hero__grid">
    <div class="hero__stage" aria-hidden="true">
      {%- assign hv_src = section.settings.video_url | default: 'video-hero-intro.mp4' -%}
      {%- if section.settings.video_url == blank -%}{%- assign hv_src = 'video-hero-intro.mp4' | asset_url -%}{%- endif -%}
      <img class="hero__poster" src="{{ 'video-hero-intro-poster.webp' | asset_url }}" width="640" height="640" alt="" fetchpriority="high" decoding="async">
      <video class="hero__video hero__video--intro" muted playsinline preload="none" poster="{{ 'video-hero-intro-poster.webp' | asset_url }}" data-video-src="{{ hv_src }}" data-ambient data-hero-video{% unless section.blocks.size > 1 %} loop{% endunless %}></video>
    </div>
    <div class="hero__copy">
      <span class="hero__rule" aria-hidden="true"></span>
      <h1>{{ tx_s_heading | escape }}{%- if tx_s_heading_em != blank %} <em>{{ tx_s_heading_em | escape }}</em>{% endif -%}</h1>
      {%- if tx_s_text != blank -%}<p class="hero__sub">{{ tx_s_text }}</p>{%- endif -%}
      {% render 'service-badge', class: 'svc-badge--hero' %}

      {%- if section.settings.show_countdown -%}
        <p><span class="countdown" data-cutoff>{{ 'cutoff.orders_close_in' | t }} <strong data-cutoff-value>…</strong></span></p>
      {%- endif -%}

      <div class="hero__cta">
        {%- if tx_s_button_label != blank -%}
          <a class="arrow-link" href="{{ section.settings.button_link | default: settings.plans_url | default: '/pages/planes' }}" data-order-cta data-returning-label="{{ 'funnel.ret_go' | t }}"><span class="arrow-link__c">{% render 'icon', name: 'arrow' %}</span>{{ tx_s_button_label }}</a>
        {%- endif -%}
        {%- if tx_s_button2_label != blank -%}
          <a class="text-link" href="{{ section.settings.button2_link | default: '/collections/menu-semanal' }}">{{ tx_s_button2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- endif -%}
  <button class="hero__toggle" type="button" data-media-toggle aria-pressed="false" aria-label="{{ 'media.pause' | t }}">{% render 'icon', name: 'pause' %}</button>
  <span class="hero__scroll" aria-hidden="true"><i></i>{{ 'hero.scroll' | t }}</span>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (parte en tipografía normal)", "default": "Una semana, servida como" },
    { "type": "text", "id": "heading_em", "label": "Título (parte en cursiva de marca)", "default": "una pieza de autor." },
    { "type": "text", "id": "text", "label": "Subtítulo", "default": "Platillos preparados por chefs, adaptados a tu estilo de vida." },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Haz tu pedido" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "button2_label", "label": "Enlace secundario", "default": "Ver los especiales de la semana" },
    { "type": "url", "id": "button2_link", "label": "Enlace secundario (URL)" },
    { "type": "checkbox", "id": "show_countdown", "label": "Mostrar cuenta regresiva de cierre", "default": false },
    { "type": "range", "id": "slide_seconds", "label": "Segundos por diapositiva", "min": 3, "max": 12, "step": 1, "default": 4, "info": "Segundos que se ve cada diapositiva. El carrusel empieza cuando el video de introducción termina (una sola vez)." },
    { "type": "text", "id": "video_url", "label": "Video propio (URL .mp4 cuadrado, opcional)", "info": "Vacío = el video de intro de la marca (video-hero-intro.mp4 en Assets)." }
  ],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        { "type": "text", "id": "tag", "label": "Etiqueta (Evento, Aviso, Temporada…)", "default": "Evento" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Chef privado en tu casa" },
        { "type": "textarea", "id": "text", "label": "Texto corto", "default": "Una cena de autor para tu mesa o tu evento." },
        { "type": "text", "id": "button_label", "label": "Botón", "default": "Conocer más" },
        { "type": "url", "id": "button_link", "label": "Enlace del botón" },
        { "type": "image_picker", "id": "image", "label": "Foto (cuadrada, opcional)" },
        { "type": "text", "id": "art", "label": "Foto del tema si no subes una", "info": "Claves: air-steak, air-chef, air-romance, air-bowl, air-breakfast, air-glass, air-fish, dinner, containers, flames.", "default": "air-chef" }
      ]
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
