<section class="section" {{ section.shopify_attributes }}>
  <div class="container" style="max-width:560px">
    <div class="section__head"><span class="eyebrow">Mi cuenta</span><h1 style="font-size:2.4rem">Restablecer contraseña</h1></div>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="alert alert--warn" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="rp-pass">Nueva contraseña</label><input class="input" id="rp-pass" type="password" name="customer[password]" required autocomplete="new-password"></div>
      <div class="field"><label for="rp-conf">Confirmar contraseña</label><input class="input" id="rp-conf" type="password" name="customer[password_confirmation]" required autocomplete="new-password"></div>
      <button class="btn btn--gold btn--block" type="submit">Guardar contraseña</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Restablecer contraseña", "settings": [] }
{% endschema %}
