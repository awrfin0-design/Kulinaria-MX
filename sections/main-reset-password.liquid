<section class="section" {{ section.shopify_attributes }}>
  <div class="container" style="max-width:560px">
    <div class="section__head"><span class="eyebrow">{{ 'general.account' | t }}</span><h2 style="font-size:2.4rem">{{ 'reset.title' | t }}</h2></div>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="alert alert--warn" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="rp-pass">{{ 'reset.new' | t }}</label><input class="input" id="rp-pass" type="password" name="customer[password]" required autocomplete="new-password"></div>
      <div class="field"><label for="rp-conf">{{ 'reset.confirm' | t }}</label><input class="input" id="rp-conf" type="password" name="customer[password_confirmation]" required autocomplete="new-password"></div>
      <button class="btn btn--gold btn--block" type="submit">{{ 'reset.save' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Restablecer contraseña", "settings": [] }
{% endschema %}
