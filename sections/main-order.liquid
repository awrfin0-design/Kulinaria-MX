<section class="section" {{ section.shopify_attributes }}>
  <div class="container" style="max-width:960px">
    <div class="section__head">
      <span class="eyebrow">{{ 'account.order' | t }}</span>
      <h2 style="font-size:clamp(2rem,4vw,3rem)">{{ order.name }}</h2>
      <p class="text-muted">{{ order.created_at | date: '%d/%m/%Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
      <a class="btn btn--ghost" href="/pages/cuenta">{{ 'general.back_account' | t }}</a>
    </div>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>{{ 'order.dish' | t }}</th><th>{{ 'order.quantity' | t }}</th><th style="text-align:right">{{ 'cart.total' | t }}</th></tr></thead>
      <tbody>
        {%- for line in order.line_items -%}{%- capture tx_ltitle -%}{% render 'tx', s: line.title %}{%- endcapture -%}{%- capture tx_lplan -%}{% render 'tx', s: line.selling_plan_allocation.selling_plan.name %}{%- endcapture -%}
          <tr>
            <td>{{ tx_ltitle }}{% if line.selling_plan_allocation %}<br><small style="color:var(--accent)">{{ tx_lplan }}</small>{% endif %}</td>
            <td>{{ line.quantity }}</td>
            <td style="text-align:right">{{ line.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><td colspan="2" style="text-align:right">{{ 'cart.subtotal' | t }}</td><td style="text-align:right">{{ order.line_items_subtotal_price | money }}</td></tr>
        {%- if order.total_discounts > 0 -%}<tr><td colspan="2" style="text-align:right">{{ 'order.discounts' | t }}</td><td style="text-align:right">-{{ order.total_discounts | money }}</td></tr>{%- endif -%}
        <tr><td colspan="2" style="text-align:right"><strong>{{ 'cart.total' | t }}</strong></td><td style="text-align:right"><strong>{{ order.total_price | money }}</strong></td></tr>
      </tfoot>
    </table></div>
    {%- if order.shipping_address -%}
      <div class="card" style="margin-top:var(--space-xl)"><h3>{{ 'account.delivery_address' | t }}</h3><p class="text-muted">{{ order.shipping_address | format_address }}</p></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Pedido", "settings": [] }
{% endschema %}
