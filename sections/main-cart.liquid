<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__head">
      <span class="eyebrow">{{ 'cart.title' | t }}</span>
      <h1 style="font-size:clamp(2.2rem,4vw,3.4rem)">{{ 'cart.title' | t }}</h1>
      <div class="divider-gold"><i></i></div>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="panel" style="text-align:center">
        <p class="lede" style="margin-inline:auto">{{ 'cart.empty' | t }}</p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn--gold" href="/collections/menu-semanal">{{ 'general.view_week_menu' | t }}</a>
          <a class="btn btn--outline" href="{{ settings.plans_url | default: '/pages/planes' }}">{{ 'nav.cta' | t }}</a>
        </div>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart" data-cart-form>
        <div>
          {%- for item in cart.items -%}
            <div class="cart-line">
              <a href="{{ item.url }}">
                {%- if item.image -%}{{ item.image | image_url: width: 192 | image_tag: loading: 'lazy', alt: item.product.title }}{%- else -%}<span class="dish__ph surface-slate" style="width:96px;font-size:2rem">{% render 'logo', mark: true %}</span>{%- endif -%}
              </a>
              <div>
                <h3 style="margin:0 0 4px"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                {%- unless item.product.has_only_default_variant -%}<p class="text-muted" style="margin:0">{{ item.variant.title }}</p>{%- endunless -%}
                {%- if item.selling_plan_allocation -%}<p class="cart-line__plan" style="margin:0">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
                {%- if item.properties._regalo_bienvenida -%}<p class="cart-line__plan" style="margin:0">{{ 'cart.welcome_gift_line' | t }}</p>{%- endif -%}
                <a class="btn btn--ghost" style="padding-left:0" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              </div>
              <div style="text-align:right">
                <input class="input qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'cart.quantity_of' | t }} {{ item.product.title | escape }}">
                <p class="dish__price" style="margin:8px 0 0">
                  {%- if item.original_line_price != item.final_line_price -%}<s class="text-muted" style="font-size:.9rem">{{ item.original_line_price | money }}</s> {%- endif -%}
                  {{ item.final_line_price | money }}
                </p>
              </div>
            </div>
          {%- endfor -%}
          <button class="btn btn--outline" type="submit" name="update" style="margin-top:var(--space-lg)">{{ 'cart.update' | t }}</button>
        </div>

        <aside class="summary">
          <div class="panel">
            <h3>{{ 'cart.referral_title' | t }}</h3>
            <p class="text-muted">{{ 'cart.referral_text' | t }}</p>
            <div class="field">
              <label for="ref">{{ 'cart.code' | t }}</label>
              <input class="input" id="ref" name="attributes[codigo_referencia]" value="{{ cart.attributes.codigo_referencia }}" placeholder="JUANFIT" data-referral autocomplete="off" style="text-transform:uppercase">
            </div>

            <div data-gift hidden style="margin-top:var(--space-lg)">
              <h3>{{ 'cart.gift_title' | t }}</h3>
              <p class="text-muted">{{ 'cart.gift_text' | t }}</p>
              {%- assign gift_col = settings.welcome_gift_collection -%}
              <div class="gift-options">
                {%- if gift_col != blank -%}
                  {%- assign gift_n = 0 -%}
                  {%- for product in gift_col.products -%}
                    {%- for variant in product.variants -%}
                      {%- assign gift_n = gift_n | plus: 1 -%}
                      <label><input type="radio" name="gift" value="{{ variant.id }}" {% if gift_n == 1 %}checked{% endif %}>
                        <span>{{ product.title }}{% unless product.has_only_default_variant %} · {{ variant.title }}{% endunless %} <s class="text-muted">{{ variant.price | money_without_trailing_zeros }}</s> <strong style="color:var(--accent)">$0</strong></span></label>
                    {%- endfor -%}
                  {%- endfor -%}
                {%- else -%}
                  <p class="alert">{{ 'cart.gift_missing' | t }}</p>
                {%- endif -%}
              </div>
              {%- if gift_col != blank -%}<button class="btn btn--outline btn--block" type="button" data-gift-add style="margin-top:var(--space-md)">{{ 'cart.gift_add' | t }}</button>{%- endif -%}
            </div>
            <p class="alert alert--ok" data-referral-msg hidden style="margin-top:var(--space-md)">{{ 'cart.referral_saved' | t }}</p>
          </div>

          <div class="panel panel--gold">
            {%- if cart.total_discount > 0 -%}
              <p class="alert alert--ok">{{ 'cart.saved_pre' | t }} {{ cart.total_discount | money }}{% if cart.attributes.codigo_referencia != blank %} {{ 'cart.saved_post' | t }}{% endif %}!</p>
            {%- endif -%}
            <div class="summary__row"><span class="text-muted">{{ 'cart.subtotal' | t }}</span><span>{{ cart.items_subtotal_price | money }}</span></div>
            <div class="summary__row" style="margin-top:var(--space-md)"><strong>{{ 'cart.total' | t }}</strong><span class="summary__total gold-text">{{ cart.total_price | money }}</span></div>
            <p class="text-muted" style="font-size:.85rem">{{ 'cart.digital_only' | t }}</p>

            <label class="check" style="margin:var(--space-lg) 0">
              <input type="checkbox" name="attributes[contrato_aceptado]" value="sí" data-contract {% if cart.attributes.contrato_aceptado == 'sí' %}checked{% endif %}>
              <span>
                {{ 'cart.contract_label' | t }}
                {%- if settings.contract_page != blank %} <a href="{{ settings.contract_page.url }}" target="_blank" rel="noopener" style="color:var(--accent);text-decoration:underline">{{ 'cart.read_contract' | t }}</a>{% endif -%}
              </span>
            </label>

            <button class="btn btn--gold btn--block" type="submit" name="checkout" data-checkout disabled>{{ 'cart.checkout' | t }}</button>
          </div>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carrito",
  "settings": []
}
{% endschema %}
