{%- capture tx_s_eyebrow -%}{% render 'tx', s: section.settings.eyebrow %}{%- endcapture -%}
{%- capture tx_s_heading -%}{% render 'tx', s: section.settings.heading %}{%- endcapture -%}
{%- capture tx_s_text -%}{% render 'tx', s: section.settings.text %}{%- endcapture -%}
{%- capture tx_s_btn -%}{% render 'tx', s: section.settings.button_label %}{%- endcapture -%}
{%- capture tx_s_st -%}{% render 'tx', s: section.settings.strip_title %}{%- endcapture -%}
<section class="section kf" data-no-wordmark {{ section.shopify_attributes }}>
  <div class="container">
    <div class="kf__main">
      <div class="kf__copy">
        <img class="kf__logo" src="{{ 'logo-kfw.webp' | asset_url }}" width="180" height="100" alt="KFW · Kulinaria Fitness Wear" loading="lazy">
        {%- if tx_s_eyebrow != blank -%}<span class="kf__tag">{{ tx_s_eyebrow }}</span>{%- endif -%}
        <h2 class="kf__h">{{ tx_s_heading }}</h2>
        {%- if tx_s_text != blank -%}<p class="kf__p">{{ tx_s_text }}</p>{%- endif -%}
        {%- if tx_s_btn != blank -%}<a class="kf__btn" href="{{ section.settings.button_link | default: '/collections/kulinaria-store' }}">{{ tx_s_btn }}</a>{%- endif -%}
      </div>
      <div class="kf__photo">{% render 'photo', image: section.settings.image, art: section.settings.art, alt: '', class: 'kf__img', width: 1400 %}</div>
    </div>
    <div class="kf__strip">
      <h3 class="kf__st">{{ tx_s_st }}</h3>
      {%- assign kf_col = section.settings.collection | default: collections['kulinaria-store'] -%}
      {%- assign kf_n = 0 -%}
      {%- if kf_col != blank -%}{%- assign kf_n = kf_col.products.size -%}{%- endif -%}
      <div class="kf__cards{% if kf_n > 0 %} kf__cards--live{% endif %}" data-kf-cards>
        {%- if kf_n > 0 -%}
          {%- for product in kf_col.products limit: section.settings.limit -%}
            {%- capture kf_img -%}{%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="{{ 900 | divided_by: product.featured_image.aspect_ratio | round }}">{%- else -%}{% render 'photo', image: blank, art: 'kfw-duo', alt: '', class: '', width: 800 %}{%- endif -%}{%- endcapture -%}
            <div class="kf__card kf__card--p" role="button" tabindex="0" data-has-detail data-pc-card data-kf-product>
              <span class="kf__cph">
                {{ kf_img }}
                {%- unless product.available -%}<em class="kf__flag">{{ 'kfw.sold_out' | t }}</em>{%- elsif product.compare_at_price > product.price -%}<em class="kf__flag kf__flag--sale">{{ 'kfw.sale' | t }}</em>{%- endunless -%}
              </span>
              <span class="kf__ctext"><strong>{{ product.title }}</strong>{%- if product.type != blank -%}<small>{{ product.type }}</small>{%- endif -%}<b class="kf__price">{%- if product.price_varies -%}{{ 'kfw.from' | t }} {% endif -%}{{ product.price | money_without_trailing_zeros }}{%- if product.compare_at_price > product.price -%} <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}</b><i class="tr__more">{{ 'kfw.view' | t }}</i></span>
              <div data-dish-detail data-url="{{ product.url }}" data-title="{{ product.title | escape }}" hidden>
                <div class="dd__media">{{ kf_img }}</div>
                <div class="dd__body">
                  <span class="tp__role">{{ product.type | default: 'KFW' }}</span>
                  <h2 class="dd__title">{{ product.title }}</h2>
                  <p class="kf__pprice">{%- if product.price_varies -%}{{ 'kfw.from' | t }} {% endif -%}{{ product.price | money_without_trailing_zeros }}{%- if product.compare_at_price > product.price -%} <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}</p>
                  {%- assign kf_desc = product.description | strip_html | strip -%}
                  {%- if kf_desc != blank -%}<p class="dd__desc">{{ kf_desc | truncate: 320 }}</p>{%- endif -%}
                  <form class="kf__form" data-kf-form action="/cart/add" method="post">
                    {%- if product.variants.size > 1 -%}
                      <label class="kf__sel"><span>{{ 'kfw.option' | t }}</span>
                        <select name="id">{%- for v in product.variants -%}<option value="{{ v.id }}"{% unless v.available %} disabled{% endunless %}{% if v.id == product.selected_or_first_available_variant.id %} selected{% endif %}>{{ v.title }}{% unless v.available %} · {{ 'kfw.sold_out' | t }}{% endunless %}</option>{%- endfor -%}</select>
                      </label>
                    {%- else -%}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{%- endif -%}
                    <button class="btn btn--gold" type="submit"{% unless product.available %} disabled{% endunless %}>{{ 'kfw.add' | t }}</button>
                  </form>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
        {%- for block in section.blocks -%}{%- assign bs = block.settings -%}
          {%- capture tx_t -%}{% render 'tx', s: bs.title %}{%- endcapture -%}
          {%- capture tx_x -%}{% render 'tx', s: bs.text %}{%- endcapture -%}
          <a class="kf__card" href="{{ bs.link | default: '/collections/kulinaria-store' }}" {{ block.shopify_attributes }}>
            <span class="kf__cph">{% render 'photo', image: bs.image, art: bs.art, alt: '', class: '', width: 400 %}</span>
            <span class="kf__ctext"><strong>{{ tx_t }}</strong><small>{{ tx_x }}</small></span>
          </a>
        {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KFW · Fitness Wear",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "KFW • Kulinaria Fitness Wear" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Viste la disciplina. Domina tu estilo." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Indumentaria deportiva de alto rendimiento diseñada para cada entrenamiento." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Explorar colección" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "image_picker", "id": "image", "label": "Foto principal (opcional)" },
    { "type": "text", "id": "art", "label": "Foto del tema si no subes una", "default": "kfw-duo" },
    { "type": "text", "id": "strip_title", "label": "Título de la colección", "default": "Colección oficial KFW" },
    { "type": "collection", "id": "collection", "label": "Colección de productos KFW", "info": "Cada producto que agregues a esta colección (chamarras, tops, joggers…) aparece aquí como tarjeta con foto, nombre y precio. Si está vacía se muestran las tarjetas de abajo." },
    { "type": "range", "id": "limit", "label": "Máximo de productos", "min": 4, "max": 24, "step": 1, "default": 12 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Categoría / producto",
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "Enterizos & tops" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Prendas integrales y de soporte para mujer." },
        { "type": "image_picker", "id": "image", "label": "Foto (opcional)" },
        { "type": "text", "id": "art", "label": "Foto del tema", "default": "kfw-tops" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "KFW · Fitness Wear" }]
}
{% endschema %}
