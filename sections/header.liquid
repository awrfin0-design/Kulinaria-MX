<header class="site-header" {{ section.shopify_attributes }}>
  <div class="container site-header__inner">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">{% render 'logo' %}</a>

    <nav class="site-nav" data-nav aria-label="Principal">
      {%- assign menu = section.settings.menu -%}
      {%- if menu != blank and menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/collections/menu-semanal">Menú</a>
        <a href="/pages/planes">Planes</a>
        <a href="/pages/carta-kulinaria">Carta Kulinaria</a>
        <a href="/pages/embajadores">Embajadores</a>
        <a href="/pages/nosotros">Nosotros</a>
      {%- endif -%}
    </nav>

    <div class="header-actions">
      <a class="icon-link" href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'user' %}</a>
      <a class="icon-link" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">
        {% render 'icon', name: 'bag' %}
        {%- if cart.item_count > 0 -%}<span class="cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
      <a class="btn btn--gold" href="{{ settings.plans_url | default: '/pages/planes' }}">{{ settings.cta_label }}</a>
      <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-label="{{ 'general.menu' | t }}">{% render 'icon', name: 'menu' %}</button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Encabezado",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menú principal", "default": "main-menu" }
  ]
}
{% endschema %}
