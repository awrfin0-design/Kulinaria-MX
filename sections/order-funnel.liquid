{%- capture tx_s_eyebrow -%}{% render 'tx', s: section.settings.eyebrow %}{%- endcapture -%}
{%- capture tx_s_heading -%}{% render 'tx', s: section.settings.heading %}{%- endcapture -%}
{%- liquid
  assign coll = section.settings.collection
  assign meals_per_week = 5
  assign plan_coll = collections['planes-semanales']
-%}
{%- assign upg = all_products['mejora-de-platillo'] -%}
<section class="section funnel{% if section.settings.phone_teaser %} funnel--teaser{% endif %}" id="pedido-{{ section.id }}" data-funnel data-cart-url="{{ routes.cart_url }}" data-meals="{{ meals_per_week }}" data-weeks="4"
  {%- if customer %} data-customer-name="{{ customer.name | escape }}" data-customer-email="{{ customer.email | escape }}"{% endif %}
  data-t-meals="{{ 'funnel.meals_of' | t }}" data-t-meal-one="{{ 'funnel.meal_one' | t }}" data-t-empty="{{ 'funnel.summary_empty' | t }}"
  data-t-need-meals="{{ 'funnel.need_meals' | t }}" data-t-full="{{ 'funnel.meals_full' | t }}" data-t-need-info="{{ 'funnel.need_info' | t }}"
  data-t-add="{{ 'funnel.add' | t }}" data-t-remembered="{{ 'funnel.remembered' | t }}" data-t-saved="{{ 'funnel.saved' | t }}"
  data-t-step-of="{{ 'funnel.step_of' | t }}" data-t-block-name="{{ 'funnel.plan_block' | t }}" data-t-week-name="{{ 'funnel.plan_week' | t }}"
  data-t-per-week="{{ 'funnel.per_week_each' | t }}" data-t-weeks-x="{{ 'funnel.weeks_x' | t }}" data-t-per-meal="{{ 'funnel.per_meal' | t }}"
  data-t-all-lines="{{ 'funnel.all_categories' | t }}" data-t-prop-dishes="{{ 'funnel.prop_dishes' | t }}" data-t-prop-meals="{{ 'funnel.prop_meals' | t }}"
  data-t-prop-tier="{{ 'funnel.prop_tier' | t }}" data-t-prop-length="{{ 'funnel.prop_length' | t }}" data-t-length-block="{{ 'funnel.length_block' | t }}" data-t-length-week="{{ 'funnel.length_week' | t }}"
  data-t-renew="{{ 'funnel.renew' | t }}" data-t-days="{{ 'funnel.days' | t }}" data-t-rolled="{{ 'funnel.rolled' | t }}" data-t-pick="{{ 'funnel.pick' | t }}" data-t-picked="{{ 'funnel.picked' | t }}" data-t-pick-for="{{ 'funnel.pick_for' | t }}" data-t-all-done="{{ 'funnel.all_done' | t }}" data-t-clear-day="{{ 'funnel.clear_day' | t }}" data-t-first="{{ 'funnel.first_delivery' | t }}" data-t-day-empty="{{ 'funnel.day_empty' | t }}" data-t-up-badge="{{ 'funnel.up_badge' | t }}" data-t-up-total="{{ 'funnel.up_total' | t }}"
  data-t-prop-upgrade="{{ 'funnel.prop_upgrade' | t }}" data-t-need-contract="{{ 'funnel.need_contract' | t }}" data-t-days-missing="{{ 'funnel.days_missing' | t }}"
  data-upg-1="{{ upg.variants[0].price | divided_by: 100 | default: 70 }}" data-upg-2="{{ upg.variants[1].price | divided_by: 100 | default: 140 }}" data-upg-3="{{ upg.variants[2].price | divided_by: 100 | default: 210 }}"
  data-upv-1="{{ upg.variants[0].id }}" data-upv-2="{{ upg.variants[1].id }}" data-upv-3="{{ upg.variants[2].id }}" {{ section.shopify_attributes }}>
  <div class="funnel__teaser container">
    <div class="funnel__teaser-bg" aria-hidden="true">{% render 'photo', art: 'containers', alt: '' %}</div>
    <p class="funnel__teaser-kicker">{{ 'funnel.eyebrow' | t }}</p>
    <h2>{{ 'funnel.teaser_t' | t }} <button class="info-dot" type="button" data-sheet="pricing" aria-label="{{ 'sheet.info' | t }}"><i aria-hidden="true">i</i></button></h2>
    <p class="funnel__teaser-text">{{ 'funnel.teaser_p' | t }}</p>
    <ul class="funnel__teaser-facts"><li>{{ 'funnel.teaser_a' | t }}</li><li>{{ 'funnel.teaser_b' | t }}</li><li>{{ 'funnel.teaser_c' | t }}</li></ul>
    <a class="btn btn--gold btn--block" href="/pages/pedido">{{ 'funnel.teaser_cta' | t }}</a>
  </div>
  {%- unless section.settings.phone_teaser -%}<div class="funnel__bgphoto" aria-hidden="true">{% render 'photo', art: 'air-steak-dark', alt: '' %}</div>{%- endunless -%}
  <div class="funnel__track" data-fn-track>
   <div class="funnel__stage" data-fn-stage>
    <div class="funnel__top container">
      <div class="funnel__title">
        <span class="eyebrow">{{ tx_s_eyebrow }}</span>
        <h2>{% render 'headline', text: tx_s_heading %}</h2>
      </div>
      <ol class="steps__nav" aria-label="{{ 'funnel.steps' | t }}">
        <li data-fn-dot class="is-on"><span>01</span>{{ 'funnel.s1' | t }}</li>
        <li data-fn-dot><span>02</span>{{ 'funnel.s3' | t }}</li>
      </ol>
    </div>
    <p class="funnel__stepcount" data-fn-stepcount aria-live="polite"></p>
    <div class="steps__bar funnel__bar" aria-hidden="true"><i data-fn-bar></i></div>

    <div class="funnel__panel container" data-fn-panel>
      <div class="funnel__main">
        <fieldset class="step is-on" data-fn-step="1">
          <legend>{{ 'funnel.s1_title' | t }}</legend>
          <p class="text-muted">{{ 'funnel.s1_text' | t }}</p>
          <div class="fn-plans" role="radiogroup" aria-label="{{ 'funnel.s1_title' | t }}">
            <button class="fn-plan" type="button" role="radio" data-plan-choice="block" aria-checked="true">
              <span class="plan-card__flag">{{ 'plans.recommended' | t }}</span>
              <strong>{{ 'funnel.plan_block' | t }}</strong>
              <small>{{ 'funnel.plan_block_text' | t }}</small>
              <em class="fn-plan__from">{{ 'plans.from' | t }}{% render 'plan-price', tier: 'selecto', kind: 'block', money: true %}</em>
              <span class="fn-plan__incl">{{ 'funnel.includes_block' | t }}</span>
            </button>
            <button class="fn-plan" type="button" role="radio" data-plan-choice="week" aria-checked="false">
              <strong>{{ 'funnel.plan_week' | t }}</strong>
              <small>{{ 'funnel.plan_week_text' | t }}</small>
              <em class="fn-plan__from">{{ 'plans.from' | t }}{% render 'plan-price', tier: 'selecto', kind: 'week', money: true %}</em>
              <span class="fn-plan__incl">{{ 'funnel.includes_week' | t }}</span>
            </button>
          </div>
          <label class="check fn-renew" data-fn-renew hidden><input type="checkbox" data-fn-renew-box checked> <span>{{ 'funnel.renew' | t }}</span></label>
        </fieldset>

        <div class="fn-tierdata" data-fn-tierdata hidden aria-hidden="true">
            {%- liquid
              assign pp_selecto = nil
              for pp in plan_coll.products
                if pp.metafields.kulinaria.tier.value == 'selecto'
                  assign pp_selecto = pp
                endif
              endfor
            -%}
            <button class="fn-tier fn-tier--selecto" type="button" role="radio" data-tier-choice="selecto" aria-checked="true"
              data-week="{% render 'plan-price', tier: 'selecto', kind: 'week' %}" data-block="{% render 'plan-price', tier: 'selecto', kind: 'block' %}" data-meal="{% render 'plan-price', tier: 'selecto', kind: 'meal' %}"
              data-variant-week="{{ pp_selecto.variants[0].id }}" data-variant-block="{{ pp_selecto.variants[1].id | default: pp_selecto.variants[0].id }}"
              data-selling-plan="{%- if pp_selecto.selling_plan_groups.size > 0 -%}{{ pp_selecto.selling_plan_groups.first.selling_plans.first.id }}{%- endif -%}" data-name="{{ 'tier.selecto' | t }}">
              <span class="fn-tier__price" data-fn-tier-price>{% render 'plan-price', tier: 'selecto', kind: 'block', money: true %}<small data-fn-tier-sub></small></span>
              <strong>{{ 'tier.selecto' | t }}</strong><small>{{ 'funnel.tier_selecto' | t }}</small>
            </button>
            {%- liquid
              assign pp_exclusivo = nil
              for pp in plan_coll.products
                if pp.metafields.kulinaria.tier.value == 'exclusivo'
                  assign pp_exclusivo = pp
                endif
              endfor
            -%}
            <button class="fn-tier fn-tier--exclusivo" type="button" role="radio" data-tier-choice="exclusivo" aria-checked="false"
              data-week="{% render 'plan-price', tier: 'exclusivo', kind: 'week' %}" data-block="{% render 'plan-price', tier: 'exclusivo', kind: 'block' %}" data-meal="{% render 'plan-price', tier: 'exclusivo', kind: 'meal' %}"
              data-variant-week="{{ pp_exclusivo.variants[0].id }}" data-variant-block="{{ pp_exclusivo.variants[1].id | default: pp_exclusivo.variants[0].id }}"
              data-selling-plan="{%- if pp_exclusivo.selling_plan_groups.size > 0 -%}{{ pp_exclusivo.selling_plan_groups.first.selling_plans.first.id }}{%- endif -%}" data-name="{{ 'tier.exclusivo' | t }}">
              <span class="fn-tier__price" data-fn-tier-price>{% render 'plan-price', tier: 'exclusivo', kind: 'block', money: true %}<small data-fn-tier-sub></small></span>
              <strong>{{ 'tier.exclusivo' | t }}</strong><small>{{ 'funnel.tier_exclusivo' | t }}</small>
            </button>
            {%- liquid
              assign pp_signature = nil
              for pp in plan_coll.products
                if pp.metafields.kulinaria.tier.value == 'signature'
                  assign pp_signature = pp
                endif
              endfor
            -%}
            <button class="fn-tier fn-tier--signature" type="button" role="radio" data-tier-choice="signature" aria-checked="false"
              data-week="{% render 'plan-price', tier: 'signature', kind: 'week' %}" data-block="{% render 'plan-price', tier: 'signature', kind: 'block' %}" data-meal="{% render 'plan-price', tier: 'signature', kind: 'meal' %}"
              data-variant-week="{{ pp_signature.variants[0].id }}" data-variant-block="{{ pp_signature.variants[1].id | default: pp_signature.variants[0].id }}"
              data-selling-plan="{%- if pp_signature.selling_plan_groups.size > 0 -%}{{ pp_signature.selling_plan_groups.first.selling_plans.first.id }}{%- endif -%}" data-name="{{ 'tier.signature' | t }}">
              <span class="fn-tier__price" data-fn-tier-price>{% render 'plan-price', tier: 'signature', kind: 'block', money: true %}<small data-fn-tier-sub></small></span>
              <strong>{{ 'tier.signature' | t }}</strong><small>{{ 'funnel.tier_signature' | t }}</small>
            </button>
            {%- liquid
              assign pp_reserve = nil
              for pp in plan_coll.products
                if pp.metafields.kulinaria.tier.value == 'reserve'
                  assign pp_reserve = pp
                endif
              endfor
            -%}
            <button class="fn-tier fn-tier--reserve" type="button" role="radio" data-tier-choice="reserve" aria-checked="false"
              data-week="{% render 'plan-price', tier: 'reserve', kind: 'week' %}" data-block="{% render 'plan-price', tier: 'reserve', kind: 'block' %}" data-meal="{% render 'plan-price', tier: 'reserve', kind: 'meal' %}"
              data-variant-week="{{ pp_reserve.variants[0].id }}" data-variant-block="{{ pp_reserve.variants[1].id | default: pp_reserve.variants[0].id }}"
              data-selling-plan="{%- if pp_reserve.selling_plan_groups.size > 0 -%}{{ pp_reserve.selling_plan_groups.first.selling_plans.first.id }}{%- endif -%}" data-name="{{ 'tier.reserve' | t }}">
              <span class="fn-tier__price" data-fn-tier-price>{% render 'plan-price', tier: 'reserve', kind: 'block', money: true %}<small data-fn-tier-sub></small></span>
              <strong>{{ 'tier.reserve' | t }}</strong><small>{{ 'funnel.tier_reserve' | t }}</small>
            </button>
        </div>


        <fieldset class="step" data-fn-step="2">
          <legend class="fn-sr">{{ 'funnel.s3_title' | t }}</legend>
          <ol class="fn-week" data-fn-week aria-label="{{ 'funnel.days_title' | t }}"></ol>
          <div class="fn-pickbar">
            <p class="fn-prompt" data-fn-prompt aria-live="polite"></p>
            <p class="fn-meter" data-fn-meter aria-live="polite"><b data-fn-meter-n>0</b> / {{ meals_per_week }} <span>{{ 'funnel.meals_word' | t }}</span><i data-fn-meter-bar></i></p>
            <label class="fn-sel"><span class="fn-sr">{{ 'collection.category' | t }}</span>
              <select class="select" data-fn-cat>
                <option value="all">{{ 'funnel.all_categories' | t }}</option>
                {%- assign cats = 'desayunos-premium,al-fuego-y-mar,bowls-de-la-semana,diario-premium,kulinaria-junior,sopas-y-entradas,postres-y-snacks,batidos-y-bebidas' | split: ',' -%}
                {%- for c in cats -%}{%- assign ck = 'category.' | append: c -%}<option value="{{ c }}">{{ ck | t }}</option>{%- endfor -%}
              </select></label>
            <label class="fn-sel"><span class="fn-sr">{{ 'funnel.diet_filter' | t }}</span>
              <select class="select" data-fn-diet>
                <option value="all">{{ 'funnel.all_diets_short' | t }}</option>
                {%- for block in section.blocks -%}{%- capture tx_b_label -%}{% render 'tx', s: block.settings.label %}{%- endcapture -%}<option value="{{ block.settings.slug }}" {{ block.shopify_attributes }}>{{ tx_b_label }}</option>{%- endfor -%}
              </select></label>
          </div>
          <div class="fn-carousel">
            <button class="fn-arrow fn-arrow--prev" type="button" data-fn-arrow="-1" aria-label="{{ 'funnel.prev_dishes' | t }}">&#8249;</button>
            <div class="fn-dishes" data-fn-grid>
              {%- for product in coll.products limit: section.settings.limit -%}{% render 'funnel-dish', product: product %}{%- endfor -%}
            </div>
            <button class="fn-arrow fn-arrow--next" type="button" data-fn-arrow="1" aria-label="{{ 'funnel.next_dishes' | t }}">&#8250;</button>
          </div>
          <p class="alert" data-fn-empty hidden>{{ 'funnel.s3_empty' | t }}</p>
        </fieldset>


        <p class="alert alert--warn" data-fn-error hidden role="alert"></p>
        <a hidden tabindex="-1" aria-hidden="true" data-fn-login href="{% render 'login-url', back: request.path %}"></a>
        <a hidden tabindex="-1" aria-hidden="true" data-fn-onb href="/pages/bienvenida"></a>
      </div>

      <aside class="funnel__aside" aria-live="polite">
        <h3>{{ 'funnel.your_order' | t }}</h3>
        <p class="countdown fn-cut" data-cutoff>{{ 'cutoff.confirm_dishes' | t }} <strong data-cutoff-value>…</strong></p>
        <dl class="funnel__facts">
          <div><dt>{{ 'funnel.summary_plan' | t }}</dt><dd data-fn-s-plan>{{ 'funnel.plan_block' | t }}</dd></div>
          <div><dt>{{ 'funnel.summary_meals' | t }}</dt><dd data-fn-s-meals>0 / {{ meals_per_week }}</dd></div>
        </dl>
        <ul class="funnel__list" data-fn-s-list></ul>
        <p class="text-muted" data-fn-s-empty>{{ 'funnel.summary_empty' | t }}</p>
        <p class="funnel__upgrades" data-fn-s-up hidden></p>
        <div class="funnel__total"><span>{{ 'funnel.summary_total' | t }}</span><strong data-fn-s-total>$0</strong></div>
        <p class="funnel__block" data-fn-s-block hidden></p>
        <p class="fn-weeknote"><strong data-fn-first></strong> {{ 'funnel.week_note' | t }} {{ 'funnel.up_note' | t }}</p>
        <p class="text-muted" style="font-size:.85rem;margin:0" data-fn-s-count></p>
        <button class="text-link" type="button" data-fn-reset>{{ 'funnel.reset' | t }}</button>
      </aside>
    </div>
    <div class="funnel__actions container">
      <div class="steps__actions fn-actions">
        <button class="text-link" type="button" data-fn-prev hidden>{{ 'funnel.back' | t }}</button>
        <button class="btn btn--gold" type="button" data-fn-next disabled>{{ 'funnel.next' | t }}</button>
        <a class="btn btn--gold" data-fn-finish href="{{ routes.cart_url }}" hidden>{{ 'funnel.finish' | t }}</a>
      </div>
      {%- unless customer -%}
      <p class="funnel__login text-muted">{{ 'reg.have_account' | t }} <a href="{% render 'login-url', back: request.path %}">{{ 'login.title' | t }}</a></p>
      {%- endunless -%}
    </div>
   </div>
  </div>
</section>

{% schema %}
{
  "name": "Embudo de pedido",
  "settings": [
    { "type": "checkbox", "id": "phone_teaser", "label": "En el teléfono, mostrar solo una tarjeta que lleva al pedido completo", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Haz tu pedido" },
    { "type": "text", "id": "heading", "label": "Título (usa *asteriscos* para la parte en cursiva)", "default": "Arma tu pedido en *2 pasos*" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "collection", "id": "collection", "label": "Colección de los platillos" },
    { "type": "range", "id": "limit", "label": "Máximo de platillos", "min": 4, "max": 40, "step": 1, "default": 24 }
  ],
  "blocks": [
    {
      "type": "diet",
      "name": "Enfoque (dieta)",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre", "default": "Keto" },
        { "type": "text", "id": "slug", "label": "Código (metacampo diets)", "default": "keto" },
        { "type": "text", "id": "text", "label": "Descripción corta" },
        { "type": "select", "id": "art", "label": "Foto del tema", "default": "dish-0", "options": [
          { "value": "dish-0", "label": "Platillo 1" }, { "value": "dish-1", "label": "Platillo 2" }, { "value": "dish-2", "label": "Platillo 3" }, { "value": "dish-3", "label": "Platillo 4" },
          { "value": "dish-4", "label": "Platillo 5" }, { "value": "dish-5", "label": "Platillo 6" }, { "value": "dish-6", "label": "Platillo 7" }, { "value": "dish-7", "label": "Platillo 8" } ] }
      ]
    }
  ],
  "presets": [{ "name": "Embudo de pedido" }]
}
{% endschema %}
