{% schema %}
{
  "name": "Embudo de pedido",
  "settings": [
    { "type": "checkbox", "id": "phone_teaser", "label": "En el teléfono, mostrar solo una tarjeta que lleva al pedido completo", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Haz tu pedido" },
    { "type": "text", "id": "heading", "label": "Título (usa *asteriscos* para la parte en cursiva)", "default": "Arma tu pedido en *2 pasos*" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "collection", "id": "collection", "label": "Colección de los platillos" },
    { "type": "range", "id": "limit", "label": "Máximo de platillos", "min": 4, "max": 40, "step": 1, "default": 24 }
  ],
  "blocks": [
    {
      "type": "diet",
      "name": "Enfoque (dieta)",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre", "default": "Keto" },
        { "type": "text", "id": "slug", "label": "Código (metacampo diets)", "default": "keto" },
        { "type": "text", "id": "text", "label": "Descripción corta" },
        { "type": "select", "id": "art", "label": "Foto del tema", "default": "dish-0", "options": [
          { "value": "dish-0", "label": "Platillo 1" }, { "value": "dish-1", "label": "Platillo 2" }, { "value": "dish-2", "label": "Platillo 3" }, { "value": "dish-3", "label": "Platillo 4" },
          { "value": "dish-4", "label": "Platillo 5" }, { "value": "dish-5", "label": "Platillo 6" }, { "value": "dish-6", "label": "Platillo 7" }, { "value": "dish-7", "label": "Platillo 8" } ] }
      ]
    }
  ],
  "presets": [{ "name": "Embudo de pedido" }]
}
{% endschema %}
