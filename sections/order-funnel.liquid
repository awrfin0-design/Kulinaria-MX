{%- capture tx_s_eyebrow -%}{% render 'tx', s: section.settings.eyebrow %}{%- endcapture -%}
{%- capture tx_s_heading -%}{% render 'tx', s: section.settings.heading %}{%- endcapture -%}
{%- liquid
  assign coll = section.settings.collection
  assign meals_per_week = 5
  assign plan_coll = collections['planes-semanales']
-%}
{%- assign upg = all_products['mejora-de-platillo'] -%}
<section class="section funnel{% if section.settings.phone_teaser %} funnel--teaser{% endif %}" id="pedido-{{ section.id }}" data-funnel{% if section.settings.phone_teaser %} data-phone-teaser{% endif %} data-cart-url="{{ routes.cart_url }}" data-meals="{{ meals_per_week }}" data-weeks="4"
  {%- if customer %} data-customer-name="{{ customer.name | escape }}" data-customer-email="{{ customer.email | escape }}"{% endif %}
  data-t-meals="{{ 'funnel.meals_of' | t }}" data-t-meal-one="{{ 'funnel.meal_one' | t }}" data-t-empty="{{ 'funnel.summary_empty' | t }}"
  data-t-need-meals="{{ 'funnel.need_meals' | t }}" data-t-full="{{ 'funnel.meals_full' | t }}" data-t-need-info="{{ 'funnel.need_info' | t }}"
  data-t-add="{{ 'funnel.add' | t }}" data-t-remembered="{{ 'funnel.remembered' | t }}" data-t-saved="{{ 'funnel.saved' | t }}"
  data-t-step-of="{{ 'funnel.step_of' | t }}" data-t-block-name="{{ 'funnel.plan_block' | t }}" data-t-week-name="{{ 'funnel.plan_week' | t }}"
  data-t-per-week="{{ 'funnel.per_week_each' | t }}" data-t-weeks-x="{{ 'funnel.weeks_x' | t }}" data-t-per-meal="{{ 'funnel.per_meal' | t }}"
  data-t-all-lines="{{ 'funnel.all_categories' | t }}" data-t-prop-dishes="{{ 'funnel.prop_dishes' | t }}" data-t-prop-meals="{{ 'funnel.prop_meals' | t }}"
  data-t-prop-tier="{{ 'funnel.prop_tier' | t }}" data-t-prop-length="{{ 'funnel.prop_length' | t }}" data-t-length-block="{{ 'funnel.length_block' | t }}" data-t-length-week="{{ 'funnel.length_week' | t }}"
  data-t-budget="{{ 'funnel.budget' | t }}" data-t-budget-short="{{ 'funnel.budget_short' | t }}" data-t-budget-x="{{ 'funnel.budget_x' | t }}" data-t-budget-ok="{{ 'funnel.budget_ok' | t }}" data-t-how-open="{{ 'funnel.how_open' | t }}" data-t-pick-day="{{ 'funnel.pick_day' | t }}" data-t-tour-1="{{ 'funnel.tour_1' | t }}" data-t-tour-2="{{ 'funnel.tour_2' | t }}" data-t-tour-2m="{{ 'funnel.tour_2m' | t }}" data-t-tour-3="{{ 'funnel.tour_3' | t }}" data-t-tour-4="{{ 'funnel.tour_4' | t }}" data-t-tour-next="{{ 'funnel.tour_next' | t }}" data-t-tour-done="{{ 'funnel.tour_done' | t }}" data-t-tour-skip="{{ 'funnel.tour_skip' | t }}" data-t-tour-guide="{{ 'funnel.tour_guide' | t }}" data-t-locked="{{ 'funnel.locked' | t }}" data-t-mods-done="{{ 'funnel.mods_done' | t }}" data-t-mods-edit="{{ 'funnel.mods_edit' | t }}" data-t-mods-title="{{ 'funnel.mods_title' | t }}" data-t-mods-hint="{{ 'funnel.mods_hint' | t }}" data-t-mods-note="{{ 'funnel.mods_note' | t }}" data-t-mods-ph="{{ 'funnel.mods_ph' | t }}" data-t-mods-warn="{{ 'funnel.mods_warn' | t }}" data-t-mods-without="{{ 'funnel.mods_without' | t }}" data-t-prop-notes="{{ 'funnel.prop_notes' | t }}" data-t-mods-open="{{ 'funnel.mods_open' | t }}"
  data-t-para-me="{{ 'funnel.para_me' | t }}" data-t-prop-for="{{ 'funnel.prop_for' | t }}"
  data-t-renew="{{ 'funnel.renew' | t }}" data-t-days="{{ 'funnel.days' | t }}" data-t-finish="{{ 'funnel.finish' | t }}" data-t-finish-guest="{{ 'funnel.finish_guest' | t }}" data-t-credit="{{ 'funnel.credit' | t }}" data-t-rolled="{{ 'funnel.rolled' | t }}" data-t-pick="{{ 'funnel.pick' | t }}" data-t-picked="{{ 'funnel.picked' | t }}" data-t-pick-for="{{ 'funnel.pick_for' | t }}" data-t-pick2-for="{{ 'funnel.pick2_for' | t }}" data-t-need-first="{{ 'funnel.need_first' | t }}" data-t-macros-empty="{{ 'funnel.m_empty' | t }}" data-t-all-done="{{ 'funnel.all_done' | t }}" data-t-clear-day="{{ 'funnel.clear_day' | t }}" data-t-first="{{ 'funnel.first_delivery' | t }}" data-t-day-empty="{{ 'funnel.day_empty' | t }}" data-t-up-badge="{{ 'funnel.up_badge' | t }}" data-t-up-total="{{ 'funnel.up_total' | t }}"
  data-t-prop-upgrade="{{ 'funnel.prop_upgrade' | t }}" data-t-need-contract="{{ 'funnel.need_contract' | t }}" data-t-days-missing="{{ 'funnel.days_missing' | t }}"
  data-upg-1="{{ upg.variants[0].price | divided_by: 100 | default: 70 }}" data-upg-2="{{ upg.variants[1].price | divided_by: 100 | default: 140 }}" data-upg-3="{{ upg.variants[2].price | divided_by: 100 | default: 210 }}"
  data-upv-1="{{ upg.variants[0].id }}" data-upv-2="{{ upg.variants[1].id }}" data-upv-3="{{ upg.variants[2].id }}" {{ section.shopify_attributes }}>
  <div class="funnel__teaser container">
    <div class="funnel__teaser-bg" aria-hidden="true">{% render 'photo', art: 'containers', alt: '' %}</div>
    <p class="funnel__teaser-kicker">{{ 'funnel.eyebrow' | t }}</p>
    <h2>{{ 'funnel.teaser_t' | t }} <button class="info-dot" type="button" data-sheet="pricing" aria-label="{{ 'sheet.info' | t }}"><i aria-hidden="true">i</i></button></h2>
    <p class="funnel__teaser-text">{{ 'funnel.teaser_p' | t }}</p>
    <ul class="funnel__teaser-facts"><li>{{ 'funnel.teaser_a' | t }}</li><li>{{ 'funnel.teaser_b' | t }}</li><li>{{ 'funnel.teaser_c' | t }}</li></ul>
    <a class="btn btn--gold btn--block" href="/pages/pedido" data-order-cta data-returning-label="{{ 'funnel.ret_go' | t }}">{{ 'funnel.teaser_cta' | t }}</a>
  </div>
  {%- unless section.settings.phone_teaser -%}<div class="funnel__bgphoto" aria-hidden="true">{% render 'photo', art: 'air-steak-dark', alt: '' %}</div>{%- endunless -%}
  <div class="funnel__track" data-fn-track>
   <div class="funnel__stage" data-fn-stage>
    <div class="fn-returning container" data-fn-returning hidden>
      <h3>{{ 'funnel.ret_t' | t }}</h3>
      <p data-fn-returning-text></p>
      <p class="fn-returning__hint">{{ 'funnel.ret_hint' | t }}</p>
      <div class="fn-returning__row"><a class="btn btn--gold" href="/pages/cuenta-semana">{{ 'funnel.ret_go' | t }} &rarr;</a><button class="text-link" type="button" data-fn-newplan>{{ 'funnel.ret_new' | t }}</button></div>
    </div>
    <div class="funnel__top container">
      <div class="funnel__title">
        <span class="eyebrow">{{ tx_s_eyebrow }}</span>
        <h2>{% render 'headline', text: tx_s_heading %}</h2>
      </div>
      <ol class="steps__nav" aria-label="{{ 'funnel.steps' | t }}">
        <li data-fn-dot class="is-on"><span>01</span>{{ 'funnel.s_rules' | t }}</li>
        <li data-fn-dot><span>02</span>{{ 'funnel.s1' | t }}</li>
        <li data-fn-dot><span>03</span>{{ 'funnel.s_menu' | t }}</li>
        <li data-fn-dot><span>04</span>{%- if customer -%}{{ 'funnel.s_week2' | t }}{%- else -%}{{ 'funnel.s_week' | t }}{%- endif -%}</li>
      </ol>
    </div>
    <p class="funnel__stepcount" data-fn-stepcount aria-live="polite"></p>
    <div class="steps__bar funnel__bar" aria-hidden="true"><i data-fn-bar></i></div>

    <div class="funnel__panel container" data-fn-panel>
      <div class="funnel__main">
        <fieldset class="step is-on" data-fn-step="0">
          <legend class="fn-sr">{{ 'funnel.rules_title' | t }}</legend>
          {%- capture r_bn %}{% render 'plan-price', tier: 'selecto', kind: 'block' %}{% endcapture -%}
          {%- capture r_wn %}{% render 'plan-price', tier: 'selecto', kind: 'week' %}{% endcapture -%}
          {%- capture r_mn %}{% render 'plan-price', tier: 'selecto', kind: 'meal' %}{% endcapture -%}
          {%- assign r_bn = r_bn | strip | plus: 0 -%}{%- assign r_wn = r_wn | strip | plus: 0 -%}{%- assign r_mn = r_mn | strip | plus: 0 -%}
          {%- assign r_block = r_bn | times: 100 | money_without_trailing_zeros -%}
          {%- assign r_week = r_wn | times: 100 | money_without_trailing_zeros -%}
          {%- assign r_meal = r_mn | times: 100 | money_without_trailing_zeros -%}
          {%- assign r_wk = r_bn | divided_by: 4 | times: 100 | money_without_trailing_zeros -%}
          <div class="fn-rules" data-fn-rules>
            <div class="fn-rules__head"><h3 class="fn-rules__title">{{ 'funnel.rules_title' | t }}</h3><p class="fn-rules__lede">{{ 'funnel.rules_lede' | t }}</p>{% render 'service-badge' %}</div>
            <div class="fn-rules__carousel">
              <button class="fn-arrow fn-arrow--prev" type="button" data-fn-rules-arrow="-1" aria-label="{{ 'funnel.prev_dishes' | t }}">&#8249;</button>
              <div class="fn-rules__rail" data-fn-rules-rail>
                {%- comment -%} The guide: four steps for visitors, three once they are signed in (the sign-in step is gone) {%- endcomment -%}
                <article class="fn-rcard fn-rg">
                  <p class="fn-rg__lab">{{ 'funnel.rg_l1' | t }}</p>
                  <p class="fn-rg__p">{{ 'funnel.rg1_p_html' | t }}</p>
                  <div class="fn-rg__opts"><div class="fn-rg__opt"><p>{{ 'funnel.rg1_a_html' | t }}</p></div><div class="fn-rg__opt"><p>{{ 'funnel.rg1_b_html' | t }}</p></div></div>
                </article>
                <article class="fn-rcard fn-rg">
                  <p class="fn-rg__lab">{{ 'funnel.rg_l2' | t }}</p>
                  <p class="fn-rg__p">{{ 'funnel.rg2_p' | t }}</p>
                  <p class="fn-rg__q">{{ 'funnel.rg2_q' | t }}</p>
                  <p class="fn-rg__note">{{ 'funnel.rg2_n' | t }}</p>
                </article>
                <article class="fn-rcard fn-rg fn-rg--ex"{% if customer %} data-fn-rules-last{% endif %}>
                  <p class="fn-rg__lab">{{ 'funnel.rg_l3' | t }}</p>
                  <p class="fn-rg__p">{{ 'funnel.rg3_p_html' | t }}</p>
                  <div class="fn-ex">
                    <div class="fn-ex__card">
                      <h5>{{ 'funnel.rg3_c_t' | t }}<small>{{ 'funnel.rg3_c_s' | t }}</small></h5>
                      <div class="fn-ex__bar"><i class="is-glow">{{ 'funnel.rg3_c_bar' | t }}</i></div>
                      <p class="fn-ex__m">{{ 'funnel.rg3_c_m' | t }}</p>
                      <p class="fn-ex__ok"><span aria-hidden="true">&#10003;</span>{{ 'funnel.rg3_c_ok' | t }}</p>
                    </div>
                    <div class="fn-ex__card">
                      <h5>{{ 'funnel.rg3_p_t' | t }}<small>{{ 'funnel.rg3_p_s' | t }}</small></h5>
                      <div class="fn-ex__bar"><i class="is-base">{{ 'funnel.rg3_p_bar1' | t }}</i><i class="is-extra">{{ 'funnel.rg3_p_bar2' | t }}</i></div>
                      <p class="fn-ex__m2"><span>{{ 'funnel.rg3_p_m1' | t }}</span><span>{{ 'funnel.rg3_p_m2' | t }}</span></p>
                      <p class="fn-ex__tot">{{ 'funnel.rg3_p_tot' | t }}</p>
                      <p class="fn-ex__pay"><span aria-hidden="true">&rarr;</span><b>{{ 'funnel.rg3_p_pay' | t }}</b></p>
                    </div>
                  </div>
                </article>
                {%- unless customer -%}
                <article class="fn-rcard fn-rg fn-rg--signin" data-fn-rules-signin data-fn-rules-last>
                  <p class="fn-rg__lab">{{ 'funnel.rg_l4' | t }}</p>
                  <div class="fn-su">
                    <h4>{{ 'funnel.rg4_t' | t }}</h4>
                    <ul><li>{{ 'funnel.rg4_b1' | t }}</li><li>{{ 'funnel.rg4_b2' | t }}</li><li>{{ 'funnel.rg4_b3' | t }}</li></ul>
                    <a class="btn btn--gold fn-su__btn" href="{% render 'login-url', back: '/pages/bienvenida' %}">{{ 'login.enter' | t }}</a>
                  </div>
                </article>
                {%- endunless -%}
                <article class="fn-rcard fn-rcard--final" data-fn-rules-final><b class="fn-rules__n">&#10003;</b><h4>{{ 'funnel.rules_final_t' | t }}</h4><div data-fn-rules-slot></div></article>
              </div>
              <button class="fn-arrow fn-arrow--next" type="button" data-fn-rules-arrow="1" aria-label="{{ 'funnel.next_dishes' | t }}">&#8250;</button>
            </div>
            <div class="fn-rules__end" data-fn-rules-end>
              <p class="fn-rules__hint" data-fn-rules-hint>{{ 'funnel.rules_scroll' | t }} &rarr;</p>
              <label class="check fn-rules__check"><input type="checkbox" data-fn-rules-check disabled> <span>{{ 'funnel.rules_check' | t }}</span></label>
              <button class="btn btn--gold" type="button" data-fn-rules-next disabled>{{ 'funnel.rules_next' | t }} &rarr;</button>
            </div>
          </div>
        </fieldset>
        <fieldset class="step" data-fn-step="1">
          <legend>{{ 'funnel.s1_title' | t }}</legend>
          <p class="text-muted">{{ 'funnel.s1_text' | t }}</p>
          <div class="fn-credit" data-fn-credit hidden><p data-fn-credit-text></p><a class="btn btn--outline btn--sm" href="/pages/cuenta-semana" data-fn-credit-link>{{ 'funnel.credit_cta' | t }}</a></div>
          <div class="fn-plans" role="radiogroup" aria-label="{{ 'funnel.s1_title' | t }}">
            <button class="fn-plan" type="button" role="radio" data-plan-choice="block" aria-checked="true">
              <span class="plan-card__flag">{{ 'plans.recommended' | t }}</span>
              <strong>{{ 'funnel.plan_block' | t }}</strong>
              <small>{{ 'funnel.plan_block_text' | t }}</small>
              <em class="fn-plan__from">{{ 'plans.from' | t }}{% render 'plan-price', tier: 'selecto', kind: 'block', money: true %}</em>
              <span class="fn-plan__incl">{{ 'funnel.includes_block' | t }}</span>
            </button>
            <button class="fn-plan" type="button" role="radio" data-plan-choice="week" aria-checked="false">
              <strong>{{ 'funnel.plan_week' | t }}</strong>
              <small>{{ 'funnel.plan_week_text' | t }}</small>
              <em class="fn-plan__from">{{ 'plans.from' | t }}{% render 'plan-price', tier: 'selecto', kind: 'week', money: true %}</em>
              <span class="fn-plan__incl">{{ 'funnel.includes_week' | t }}</span>
            </button>
          </div>
          <label class="check fn-renew" data-fn-renew hidden><input type="checkbox" data-fn-renew-box checked> <span>{{ 'funnel.renew' | t }}</span></label>
        </fieldset>

        <div class="fn-tierdata" data-fn-tierdata hidden aria-hidden="true">
            {%- liquid
              assign pp_selecto = nil
              for pp in plan_coll.products
                if pp.metafields.kulinaria.tier.value == 'selecto'
                  assign pp_selecto = pp
                endif
              endfor
            -%}
            <button class="fn-tier fn-tier--selecto" type="button" role="radio" data-tier-choice="selecto" aria-checked="true"
              data-week="{% render 'plan-price', tier: 'selecto', kind: 'week' %}" data-block="{% render 'plan-price', tier: 'selecto', kind: 'block' %}" data-meal="{% render 'plan-price', tier: 'selecto', kind: 'meal' %}"
              data-variant-week="{{ pp_selecto.variants[0].id }}" data-variant-block="{{ pp_selecto.variants[1].id | default: pp_selecto.variants[0].id }}"
              data-selling-plan="{%- if pp_selecto.selling_plan_groups.size > 0 -%}{{ pp_selecto.selling_plan_groups.first.selling_plans.first.id }}{%- endif -%}" data-name="{{ 'tier.selecto' | t }}">
              <span class="fn-tier__price" data-fn-tier-price>{% render 'plan-price', tier: 'selecto', kind: 'block', money: true %}<small data-fn-tier-sub></small></span>
              <strong>{{ 'tier.selecto' | t }}</strong><small>{{ 'funnel.tier_selecto' | t }}</small>
            </button>
            {%- liquid
              assign pp_exclusivo = nil
              for pp in plan_coll.products
                if pp.metafields.kulinaria.tier.value == 'exclusivo'
                  assign pp_exclusivo = pp
                endif
              endfor
            -%}
            <button class="fn-tier fn-tier--exclusivo" type="button" role="radio" data-tier-choice="exclusivo" aria-checked="false"
              data-week="{% render 'plan-price', tier: 'exclusivo', kind: 'week' %}" data-block="{% render 'plan-price', tier: 'exclusivo', kind: 'block' %}" data-meal="{% render 'plan-price', tier: 'exclusivo', kind: 'meal' %}"
              data-variant-week="{{ pp_exclusivo.variants[0].id }}" data-variant-block="{{ pp_exclusivo.variants[1].id | default: pp_exclusivo.variants[0].id }}"
              data-selling-plan="{%- if pp_exclusivo.selling_plan_groups.size > 0 -%}{{ pp_exclusivo.selling_plan_groups.first.selling_plans.first.id }}{%- endif -%}" data-name="{{ 'tier.exclusivo' | t }}">
              <span class="fn-tier__price" data-fn-tier-price>{% render 'plan-price', tier: 'exclusivo', kind: 'block', money: true %}<small data-fn-tier-sub></small></span>
              <strong>{{ 'tier.exclusivo' | t }}</strong><small>{{ 'funnel.tier_exclusivo' | t }}</small>
            </button>
            {%- liquid
              assign pp_signature = nil
              for pp in plan_coll.products
                if pp.metafields.kulinaria.tier.value == 'signature'
                  assign pp_signature = pp
                endif
              endfor
            -%}
            <button class="fn-tier fn-tier--signature" type="button" role="radio" data-tier-choice="signature" aria-checked="false"
              data-week="{% render 'plan-price', tier: 'signature', kind: 'week' %}" data-block="{% render 'plan-price', tier: 'signature', kind: 'block' %}" data-meal="{% render 'plan-price', tier: 'signature', kind: 'meal' %}"
              data-variant-week="{{ pp_signature.variants[0].id }}" data-variant-block="{{ pp_signature.variants[1].id | default: pp_signature.variants[0].id }}"
              data-selling-plan="{%- if pp_signature.selling_plan_groups.size > 0 -%}{{ pp_signature.selling_plan_groups.first.selling_plans.first.id }}{%- endif -%}" data-name="{{ 'tier.signature' | t }}">
              <span class="fn-tier__price" data-fn-tier-price>{% render 'plan-price', tier: 'signature', kind: 'block', money: true %}<small data-fn-tier-sub></small></span>
              <strong>{{ 'tier.signature' | t }}</strong><small>{{ 'funnel.tier_signature' | t }}</small>
            </button>
            {%- liquid
              assign pp_reserve = nil
              for pp in plan_coll.products
                if pp.metafields.kulinaria.tier.value == 'reserve'
                  assign pp_reserve = pp
                endif
              endfor
            -%}
            <button class="fn-tier fn-tier--reserve" type="button" role="radio" data-tier-choice="reserve" aria-checked="false"
              data-week="{% render 'plan-price', tier: 'reserve', kind: 'week' %}" data-block="{% render 'plan-price', tier: 'reserve', kind: 'block' %}" data-meal="{% render 'plan-price', tier: 'reserve', kind: 'meal' %}"
              data-variant-week="{{ pp_reserve.variants[0].id }}" data-variant-block="{{ pp_reserve.variants[1].id | default: pp_reserve.variants[0].id }}"
              data-selling-plan="{%- if pp_reserve.selling_plan_groups.size > 0 -%}{{ pp_reserve.selling_plan_groups.first.selling_plans.first.id }}{%- endif -%}" data-name="{{ 'tier.reserve' | t }}">
              <span class="fn-tier__price" data-fn-tier-price>{% render 'plan-price', tier: 'reserve', kind: 'block', money: true %}<small data-fn-tier-sub></small></span>
              <strong>{{ 'tier.reserve' | t }}</strong><small>{{ 'funnel.tier_reserve' | t }}</small>
            </button>
        </div>


        <fieldset class="step" data-fn-step="2">
          <legend class="fn-sr">{{ 'funnel.s_menu' | t }}</legend>
          {%- assign seasonal_f = collections['temporada'] -%}
          {%- if seasonal_f.products.size > 0 -%}
            <div class="season-toggle season-toggle--fn" role="group" aria-label="{{ 'season.aria' | t }}">
              <button class="season-pill is-on" type="button" data-fn-season="week" aria-pressed="true">{{ 'season.week' | t }}</button>
              <button class="season-pill season-pill--s" type="button" data-fn-season="season" aria-pressed="false">&#10022; {{ 'season.season' | t }} <small>{{ 'season.limited' | t }}</small></button>
            </div>
          {%- endif -%}
          <div class="fn-menunote"><button class="text-link" type="button" data-fn-prev-sc>&lsaquo; {{ 'funnel.menu_back' | t }}</button><p>{{ 'funnel.menu_note' | t }}</p></div>
          <div class="fn-carousel fn-carousel--show">
            <button class="fn-arrow fn-arrow--prev" type="button" data-fn-sc-arrow="-1" aria-label="{{ 'funnel.prev_dishes' | t }}">&#8249;</button>
            <span class="fn-sc__count" data-fn-sc-count aria-hidden="true"></span>
            <div class="fn-showcase" data-fn-sc-grid>
              {%- for product in coll.products limit: section.settings.limit -%}{% render 'funnel-showcase-card', product: product %}{%- endfor -%}
              {%- for product in seasonal_f.products limit: 8 -%}{% render 'funnel-showcase-card', product: product, seasonal: true, show_all: true %}{%- endfor -%}
            </div>
            <button class="fn-arrow fn-arrow--next" type="button" data-fn-sc-arrow="1" aria-label="{{ 'funnel.next_dishes' | t }}">&#8250;</button>
            <button class="fn-gonext" type="button" data-fn-sc-next><span>{{ 'funnel.menu_go' | t }}</span><i aria-hidden="true">&rarr;</i></button>
          </div>
        </fieldset>
        <fieldset class="step" data-fn-step="3">
          <legend class="fn-sr">{{ 'funnel.s3_title' | t }}</legend>
    <div class="fn-gate" data-fn-gate data-t-done="{{ 'funnel.gate_done' | t }}" data-t-todo="{{ 'funnel.gate_todo' | t }}" data-t-wait="{{ 'funnel.gate_wait' | t }}" hidden>
      <div class="fn-gate__frame">
        <div class="fn-gate__intro">
          <span class="fn-flame" aria-hidden="true"></span>
          <p class="eyebrow">{% if customer %}{{ 'funnel.gate_eye2' | t }}{% else %}{{ 'funnel.gate_eye' | t }}{% endif %}</p>
          <h3>{% if customer %}{{ 'funnel.gate_t2' | t }}{% else %}{{ 'funnel.gate_t' | t }}{% endif %}</h3>
          <p class="fn-gate__p">{% if customer %}{{ 'funnel.gate_p2' | t }}{% else %}{{ 'funnel.gate_p' | t }}{% endif %}</p>
          <ul class="fn-gate__perks"><li>{{ 'funnel.gate_b1' | t }}</li><li>{{ 'funnel.gate_b2' | t }}</li><li>{{ 'funnel.gate_b3' | t }}</li></ul>
        </div>
        <div class="fn-gate__flow">
        <ol class="fn-gate__steps">
          {%- unless customer -%}
          <li data-fn-gate-s1>
            <span class="fn-gate__no" aria-hidden="true">01</span>
            <div class="fn-gate__body"><span class="fn-gate__chip" data-fn-chip>{{ 'funnel.gate_todo' | t }}</span><h4>{{ 'funnel.gate_1' | t }}</h4>
              <div class="fn-gate__row" data-fn-gate-a1><a class="btn btn--gold" href="{% render 'login-url', back: '/pages/bienvenida' %}">{{ 'login.enter' | t }}</a></div>
              <p class="fn-gate__hintline" data-fn-gate-note>{{ 'login.enter_note' | t }}</p><p class="fn-gate__ok">{{ 'funnel.gate_done' | t }}</p></div>
          </li>
          {%- endunless -%}
          <li data-fn-gate-s2>
            <span class="fn-gate__no" aria-hidden="true">02</span>
            <div class="fn-gate__body"><span class="fn-gate__chip" data-fn-chip>{{ 'funnel.gate_wait' | t }}</span><h4>{{ 'funnel.gate_2' | t }}</h4>
              <p class="fn-gate__d">{{ 'funnel.gate_2d' | t }}</p>
              <ul class="fn-gate__cover" aria-label="{{ 'funnel.gate_cover' | t }}"><li>{{ 'onboarding.n1' | t }}</li><li>{{ 'onboarding.n2' | t }}</li><li>{{ 'onboarding.n3' | t }}</li><li>{{ 'onboarding.n4' | t }}</li><li>{{ 'onboarding.n5' | t }}</li></ul>
              <div class="fn-gate__row" data-fn-gate-a2><a class="btn btn--gold" href="/pages/bienvenida">{{ 'funnel.gate_go' | t }} &rarr;</a><span class="fn-gate__time">{{ 'funnel.gate_time' | t }}</span></div>
              <p class="fn-gate__ok">{{ 'funnel.gate_done' | t }}</p></div>
          </li>
        </ol>
        </div>
      </div>
    </div>
          <div class="fn-para" data-fn-para-wrap hidden><label for="fn-para-{{ section.id }}">{{ 'funnel.para' | t }}</label><select class="select" id="fn-para-{{ section.id }}" data-fn-para></select><a class="text-link" href="/pages/cuenta-perfil#familia">{{ 'funnel.para_add' | t }}</a></div>
          <ol class="fn-week" data-fn-week aria-label="{{ 'funnel.days_title' | t }}"></ol>
          <div class="fn-mods" data-fn-mods hidden></div>
          <p class="fn-budget" data-fn-budget></p>
          <p class="fn-mods__tip">✎ {{ 'funnel.mods_open' | t }}</p>
          <div class="fn-pickbar">
            <p class="fn-prompt" data-fn-prompt aria-live="polite"></p>
            <div class="fn-course fn-perday" role="group" aria-label="{{ 'funnel.perday_aria' | t }}"><span class="fn-perday__l">{{ 'funnel.perday' | t }}</span><button type="button" class="fn-course__b is-on" data-fn-perday="1" aria-pressed="true">1</button><button type="button" class="fn-course__b" data-fn-perday="2" aria-pressed="false">2</button></div>
            <div class="fn-course" data-fn-course-group hidden role="group" aria-label="{{ 'funnel.course_aria' | t }}"><button type="button" class="fn-course__b is-on" data-fn-course="0" aria-pressed="true">{{ 'funnel.c1' | t }}</button><button type="button" class="fn-course__b" data-fn-course="1" aria-pressed="false">{{ 'funnel.c2' | t }}</button></div>
            <button class="text-link fn-repeat" type="button" data-fn-repeat hidden data-t-done="{{ 'funnel.repeat_done' | t }}" data-t-none="{{ 'funnel.repeat_none' | t }}">&#8634; {{ 'funnel.repeat' | t }}</button>
            <p class="fn-meter" data-fn-meter aria-live="polite"><b data-fn-meter-n>0</b> / {{ meals_per_week }} <span>{{ 'funnel.meals_word' | t }}</span><i data-fn-meter-bar></i></p>
            <label class="fn-sel"><span class="fn-sr">{{ 'collection.category' | t }}</span>
              <select class="select" data-fn-cat>
                <option value="all">{{ 'menu_group.all' | t }}</option>
                {%- if seasonal_f.products.size > 0 -%}<option value="seasonal">&#10022; {{ 'season.season' | t }}</option>{%- endif -%}
                {%- assign cats = 'al-fuego,desayunos,bowls,diario,keto-low-carb,fit-proteina,veggie,sin-gluten,junior,entradas,snacks-postres' | split: ',' -%}
                {%- for c in cats -%}{%- assign ck = 'menu_group.' | append: c -%}<option value="{{ c }}">{{ ck | t }}</option>{%- endfor -%}
              </select></label>
          </div>
          <div class="fn-carousel">
            <button class="fn-arrow fn-arrow--prev" type="button" data-fn-arrow="-1" aria-label="{{ 'funnel.prev_dishes' | t }}">&#8249;</button>
            <div class="fn-dishes" data-fn-grid>
              {%- for product in coll.products limit: section.settings.limit -%}{% render 'funnel-dish', product: product %}{%- endfor -%}
              {%- for product in seasonal_f.products limit: 8 -%}{% render 'funnel-dish', product: product, seasonal: true, show_all: true %}{%- endfor -%}
            </div>
            <button class="fn-arrow fn-arrow--next" type="button" data-fn-arrow="1" aria-label="{{ 'funnel.next_dishes' | t }}">&#8250;</button>
            <aside class="fn-macros" data-fn-macros aria-live="polite">
              <p class="fn-macros__t">{{ 'funnel.macros_t' | t }}<small data-fn-macros-day></small></p>
              <p class="fn-macros__kcal"><b data-fn-m="kcal">&mdash;</b> <span>{{ 'funnel.m_kcal' | t }}</span></p>
              <i class="fn-macros__bar" aria-hidden="true"><u data-fn-mb="p"></u><u data-fn-mb="c"></u><u data-fn-mb="f"></u></i>
              <ul class="fn-macros__l"><li class="is-p"><span>{{ 'funnel.m_p' | t }}</span><b data-fn-m="p">&mdash;</b></li><li class="is-c"><span>{{ 'funnel.m_c' | t }}</span><b data-fn-m="c">&mdash;</b></li><li class="is-f"><span>{{ 'funnel.m_f' | t }}</span><b data-fn-m="f">&mdash;</b></li></ul>
              <p class="fn-macros__w"><span>{{ 'funnel.m_week' | t }}</span> <b data-fn-m="wk">&mdash;</b> {{ 'funnel.m_kcal' | t }}</p>
              <p class="fn-macros__h" data-fn-macros-hint>{{ 'funnel.m_empty' | t }}</p>
            </aside>
          </div>
          <p class="alert" data-fn-empty hidden>{{ 'funnel.s3_empty' | t }}</p>
        </fieldset>


        <p class="alert alert--warn" data-fn-error hidden role="alert"></p>
        <a hidden tabindex="-1" aria-hidden="true" data-fn-login href="{% render 'login-url', back: request.path %}"></a>
        <a hidden tabindex="-1" aria-hidden="true" data-fn-onb href="/pages/bienvenida"></a>
      </div>

      <aside class="funnel__aside" aria-live="polite">
        <h3>{{ 'funnel.your_order' | t }}</h3>
        <p class="countdown fn-cut" data-cutoff>{{ 'cutoff.confirm_dishes' | t }} <strong data-cutoff-value>…</strong></p>
        <dl class="funnel__facts">
          <div><dt>{{ 'funnel.summary_plan' | t }}</dt><dd data-fn-s-plan>{{ 'funnel.plan_block' | t }}</dd></div>
          <div><dt>{{ 'funnel.summary_meals' | t }}</dt><dd data-fn-s-meals>0 / {{ meals_per_week }}</dd></div>
        </dl>
        <ul class="funnel__list" data-fn-s-list></ul>
        <p class="text-muted" data-fn-s-empty>{{ 'funnel.summary_empty' | t }}</p>
        <p class="funnel__upgrades" data-fn-s-up hidden></p>
        <div class="funnel__total"><span>{{ 'funnel.summary_total' | t }}</span><strong data-fn-s-total>$0</strong></div>
        <p class="funnel__block" data-fn-s-block hidden></p>
        <p class="fn-budget fn-budget--aside" data-fn-budget></p>
        <details class="fn-more"><summary>{{ 'funnel.rec_title' | t }}</summary>
        <p class="fn-weeknote"><strong data-fn-first></strong> {{ 'funnel.week_note' | t }} {{ 'funnel.up_note' | t }}</p>
        <div class="fn-rec"><p data-fn-rec="auto" hidden>{{ 'funnel.rec_auto' | t }}</p><p data-fn-rec="manual" hidden>{{ 'funnel.rec_manual' | t }}</p><p data-fn-rec="week" hidden>{{ 'funnel.rec_week' | t }}</p><p>{{ 'funnel.rec_extra' | t }}</p></div>
        </details>
        <p class="text-muted" style="font-size:.85rem;margin:0" data-fn-s-count></p>
        <div class="fn-actions fn-cta">
          <span class="fn-links">
            <button class="text-link" type="button" data-fn-prev hidden>{{ 'funnel.back' | t }}</button>
            <button class="text-link fn-reset" type="button" data-fn-reset>{{ 'funnel.reset' | t }}</button>
          </span>
          <button class="btn btn--gold" type="button" data-fn-next disabled>{{ 'funnel.next' | t }}</button>
          <button class="btn btn--gold fn-barpick" type="button" data-fn-barpick hidden></button>
          <a class="btn btn--gold" data-fn-finish href="{{ routes.cart_url }}" hidden>{{ 'funnel.finish' | t }}</a>
        </div>
      </aside>
    </div>
   </div>
  </div>
</section>

{% schema %}
{
  "name": "Embudo de pedido",
  "settings": [
    { "type": "checkbox", "id": "phone_teaser", "label": "En el teléfono, mostrar solo una tarjeta que lleva al pedido completo", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Haz tu pedido" },
    { "type": "text", "id": "heading", "label": "Título (usa *asteriscos* para la parte en cursiva)", "default": "Arma tu pedido en *2 pasos*" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "collection", "id": "collection", "label": "Colección de los platillos" },
    { "type": "range", "id": "limit", "label": "Máximo de platillos", "min": 4, "max": 40, "step": 1, "default": 24 }
  ],
  "blocks": [
    {
      "type": "diet",
      "name": "Enfoque (dieta)",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre", "default": "Keto" },
        { "type": "text", "id": "slug", "label": "Código (metacampo diets)", "default": "keto" },
        { "type": "text", "id": "text", "label": "Descripción corta" },
        { "type": "select", "id": "art", "label": "Foto del tema", "default": "dish-0", "options": [
          { "value": "dish-0", "label": "Platillo 1" }, { "value": "dish-1", "label": "Platillo 2" }, { "value": "dish-2", "label": "Platillo 3" }, { "value": "dish-3", "label": "Platillo 4" },
          { "value": "dish-4", "label": "Platillo 5" }, { "value": "dish-5", "label": "Platillo 6" }, { "value": "dish-6", "label": "Platillo 7" }, { "value": "dish-7", "label": "Platillo 8" } ] }
      ]
    }
  ],
  "presets": [{ "name": "Embudo de pedido" }]
}
{% endschema %}
