{%- capture tx_s_eyebrow -%}{% render 'tx', s: section.settings.eyebrow %}{%- endcapture -%}
{%- capture tx_s_heading -%}{% render 'tx', s: section.settings.heading %}{%- endcapture -%}
{%- liquid
  assign coll = section.settings.collection
  assign meals_per_week = 5
  assign plan_coll = collections['planes-semanales']
-%}
{%- assign upg = all_products['mejora-de-platillo'] -%}
<section class="section funnel{% if section.settings.phone_teaser %} funnel--teaser{% endif %}" id="pedido-{{ section.id }}" data-funnel{% if section.settings.phone_teaser %} data-phone-teaser{% endif %} data-cart-url="{{ routes.cart_url }}" data-meals="{{ meals_per_week }}" data-weeks="4"
  {%- if customer %} data-customer-name="{{ customer.name | escape }}" data-customer-email="{{ customer.email | escape }}"{% endif %}
  data-t-meals="{{ 'funnel.meals_of' | t }}" data-t-meal-one="{{ 'funnel.meal_one' | t }}" data-t-empty="{{ 'funnel.summary_empty' | t }}"
  data-t-need-meals="{{ 'funnel.need_meals' | t }}" data-t-full="{{ 'funnel.meals_full' | t }}" data-t-need-info="{{ 'funnel.need_info' | t }}"
  data-t-add="{{ 'funnel.add' | t }}" data-t-remembered="{{ 'funnel.remembered' | t }}" data-t-saved="{{ 'funnel.saved' | t }}"
  data-t-step-of="{{ 'funnel.step_of' | t }}" data-t-block-name="{{ 'funnel.plan_block' | t }}" data-t-week-name="{{ 'funnel.plan_week' | t }}"
  data-t-per-week="{{ 'funnel.per_week_each' | t }}" data-t-weeks-x="{{ 'funnel.weeks_x' | t }}" data-t-per-meal="{{ 'funnel.per_meal' | t }}"
  data-t-all-lines="{{ 'funnel.all_categories' | t }}" data-t-prop-dishes="{{ 'funnel.prop_dishes' | t }}" data-t-prop-meals="{{ 'funnel.prop_meals' | t }}"
  data-t-prop-tier="{{ 'funnel.prop_tier' | t }}" data-t-prop-length="{{ 'funnel.prop_length' | t }}" data-t-length-block="{{ 'funnel.length_block' | t }}" data-t-length-week="{{ 'funnel.length_week' | t }}"
  data-t-budget="{{ 'funnel.budget' | t }}" data-t-budget-short="{{ 'funnel.budget_short' | t }}" data-t-budget-x="{{ 'funnel.budget_x' | t }}" data-t-budget-ok="{{ 'funnel.budget_ok' | t }}" data-t-how-open="{{ 'funnel.how_open' | t }}" data-t-pick-day="{{ 'funnel.pick_day' | t }}" data-t-tour-1="{{ 'funnel.tour_1' | t }}" data-t-tour-2="{{ 'funnel.tour_2' | t }}" data-t-tour-2m="{{ 'funnel.tour_2m' | t }}" data-t-tour-3="{{ 'funnel.tour_3' | t }}" data-t-tour-4="{{ 'funnel.tour_4' | t }}" data-t-tour-next="{{ 'funnel.tour_next' | t }}" data-t-tour-done="{{ 'funnel.tour_done' | t }}" data-t-tour-skip="{{ 'funnel.tour_skip' | t }}" data-t-tour-guide="{{ 'funnel.tour_guide' | t }}" data-t-locked="{{ 'funnel.locked' | t }}" data-t-mods-done="{{ 'funnel.mods_done' | t }}" data-t-mods-edit="{{ 'funnel.mods_edit' | t }}" data-t-mods-title="{{ 'funnel.mods_title' | t }}" data-t-mods-hint="{{ 'funnel.mods_hint' | t }}" data-t-mods-note="{{ 'funnel.mods_note' | t }}" data-t-mods-ph="{{ 'funnel.mods_ph' | t }}" data-t-mods-warn="{{ 'funnel.mods_warn' | t }}" data-t-mods-without="{{ 'funnel.mods_without' | t }}" data-t-prop-notes="{{ 'funnel.prop_notes' | t }}" data-t-mods-open="{{ 'funnel.mods_open' | t }}"
  data-t-para-me="{{ 'funnel.para_me' | t }}" data-t-prop-for="{{ 'funnel.prop_for' | t }}"
  data-t-renew="{{ 'funnel.renew' | t }}" data-t-days="{{ 'funnel.days' | t }}" data-t-finish="{{ 'funnel.finish' | t }}" data-t-finish-guest="{{ 'funnel.finish_guest' | t }}" data-t-credit="{{ 'funnel.credit' | t }}" data-t-rolled="{{ 'funnel.rolled' | t }}" data-t-pick="{{ 'funnel.pick' | t }}" data-t-picked="{{ 'funnel.picked' | t }}" data-t-pick-for="{{ 'funnel.pick_for' | t }}" data-t-pick2-for="{{ 'funnel.pick2_for' | t }}" data-t-need-first="{{ 'funnel.need_first' | t }}" data-t-macros-empty="{{ 'funnel.m_empty' | t }}" data-t-all-done="{{ 'funnel.all_done' | t }}" data-t-clear-day="{{ 'funnel.clear_day' | t }}" data-t-first="{{ 'funnel.first_delivery' | t }}" data-t-day-empty="{{ 'funnel.day_empty' | t }}" data-t-up-badge="{{ 'funnel.up_badge' | t }}" data-t-up-total="{{ 'funnel.up_total' | t }}"
  data-t-prop-upgrade="{{ 'funnel.prop_upgrade' | t }}" data-t-need-contract="{{ 'funnel.need_contract' | t }}" data-t-days-missing="{{ 'funnel.days_missing' | t }}"
  data-upg-1="{{ upg.variants[0].price | divided_by: 100 | default: 70 }}" data-upg-2="{{ upg.variants[1].price | divided_by: 100 | default: 140 }}" data-upg-3="{{ upg.variants[2].price | divided_by: 100 | default: 210 }}"
  data-upv-1="{{ upg.variants[0].id }}" data-upv-2="{{ upg.variants[1].id }}" data-upv-3="{{ upg.variants[2].id }}" {{ section.shopify_attributes }}>
  <div class="funnel__teaser container">
    <div class="funnel__teaser-bg" aria-hidden="true">{% render 'photo', art: 'containers', alt: '' %}</div>
    <p class="funnel__teaser-kicker">{{ 'funnel.eyebrow' | t }}</p>
    <h2>{{ 'funnel.teaser_t' | t }} <button class="info-dot" type="button" data-sheet="pricing" aria-label="{{ 'sheet.info' | t }}"><i aria-hidden="true">i</i></button></h2>
    <p class="funnel__teaser-text">{{ 'funnel.teaser_p' | t }}</p>
    <ul class="funnel__teaser-facts"><li>{{ 'funnel.teaser_a' | t }}</li><li>{{ 'funnel.teaser_b' | t }}</li><li>{{ 'funnel.teaser_c' | t }}</li></ul>
    <a class="btn btn--gold btn--block" href="/pages/pedido" data-order-cta data-returning-label="{{ 'funnel.ret_go' | t }}">{{ 'funnel.teaser_cta' | t }}</a>
  </div>
  {%- unless section.settings.phone_teaser -%}<div class="funnel__bgphoto" aria-hidden="true">{% render 'photo', art: 'air-steak-dark', alt: '' %}</div>{%- endunless -%}
  <div class="funnel__track" data-fn-track>
   <div class="funnel__stage" data-fn-stage>
    <div class="fn-returning container" data-fn-returning hidden>
      <h3>{{ 'funnel.ret_t' | t }}</h3>
      <p data-fn-returning-text></p>
      <p class="fn-returning__hint">{{ 'funnel.ret_hint' | t }}</p>
      <div class="fn-returning__row"><a class="btn btn--gold" href="/pages/cuenta-semana">{{ 'funnel.ret_go' | t }} &rarr;</a><button class="text-link" type="button" data-fn-newplan>{{ 'funnel.ret_new' | t }}</button></div>
    </div>
    <div class="funnel__top container">
      <div class="funnel__title">
        <span class="eyebrow">{{ tx_s_eyebrow }}</span>
        <h2>{% render 'headline', text: tx_s_heading %}</h2>
      </div>
      <ol class="steps__nav" aria-label="{{ 'funnel.steps' | t }}">
        <li data-fn-dot class="is-on"><span>01</span>{{ 'funnel.s_rules' | t }}</li>
        <li data-fn-dot><span>02</span>{{ 'funnel.s1' | t }}</li>
        <li data-fn-dot class="fn-dot--skip"><span>03</span>{{ 'funnel.s_menu' | t }}</li>
        <li data-fn-dot><span>03</span>{%- if customer -%}{{ 'funnel.s_week2' | t }}{%- else -%}{{ 'funnel.s_week' | t }}{%- endif -%}</li>
      </ol>
    </div>
    <p class="funnel__stepcount" data-fn-stepcount aria-live="polite"></p>
    <div class="steps__bar funnel__bar" aria-hidden="true"><i data-fn-bar></i></div>

    <div class="funnel__panel container" data-fn-panel>
      <div class="funnel__main">
        <fieldset class="step is-on" data-fn-step="0">
          <legend class="fn-sr">{{ 'funnel.rules_title' | t }}</legend>
          {%- capture st_meal -%}{% render 'plan-price', tier: 'selecto', kind: 'meal' %}{%- endcapture -%}
          {%- capture st_week -%}{% render 'plan-price', tier: 'selecto', kind: 'week' %}{%- endcapture -%}
          {%- assign st_meal_n = st_meal | strip | plus: 0 -%}{%- assign st_week_n = st_week | strip | plus: 0 -%}
          {%- assign st_meal_m = st_meal_n | times: 100 | money_without_trailing_zeros -%}
          {%- assign st_day_m = st_week_n | divided_by: 5 | times: 100 | money_without_trailing_zeros -%}
          {%- assign st_week_m = st_week_n | times: 100 | money_without_trailing_zeros -%}
          {%- assign st_bwk_m = st_meal_n | times: 5 | times: 100 | money_without_trailing_zeros -%}
          {%- assign st_blk_m = st_meal_n | times: 20 | times: 100 | money_without_trailing_zeros -%}
          {%- unless customer -%}
          <section class="fn-start" data-fn-start>
            <div class="fn-start__main">
              <span class="fn-start__flag">{{ 'funnel.start_flag' | t }}</span>
              <h3 class="fn-start__h">{{ 'funnel.start_h' | t | replace: '[p]', st_meal_m }}</h3>
              <p class="fn-start__sub">{{ 'funnel.start_sub' | t | replace: '[w]', st_bwk_m }}</p>
              <ul class="fn-start__list"><li>{{ 'funnel.start_b1' | t }}</li><li>{{ 'funnel.start_b2' | t }}</li><li>{{ 'funnel.start_b3' | t }}</li></ul>
              <a class="btn btn--gold fn-start__btn" href="{% render 'login-url', back: '/pages/pedido' %}">{{ 'login.enter' | t }}</a>
              <p class="fn-start__note">{{ 'funnel.start_note' | t }}</p>
            </div>
            <aside class="fn-start__side">
              <b class="fn-start__sk">{{ 'funnel.start_trial_t' | t }}</b>
              <p class="fn-start__sp"><strong>{{ st_day_m }}</strong> {{ 'funnel.pl_day' | t }}</p>
              {%- assign st_bwk_n = st_meal_n | times: 5 -%}{%- assign st_pct = st_week_n | minus: st_bwk_n | times: 100 | divided_by: st_bwk_n -%}
              {%- if st_pct > 0 -%}<small>{{ 'funnel.start_trial_pct' | t | replace: '[p]', st_pct }}</small>{%- endif -%}
              <small>{{ 'funnel.start_trial_s' | t }}</small>
              <a class="btn btn--outline fn-start__btn2" href="{% render 'login-url', back: '/pages/pedido' %}">{{ 'funnel.start_trial_btn' | t }}</a>
            </aside>
          </section>
          {%- endunless -%}
          {%- capture r_bn %}{% render 'plan-price', tier: 'selecto', kind: 'block' %}{% endcapture -%}
          {%- capture r_wn %}{% render 'plan-price', tier: 'selecto', kind: 'week' %}{% endcapture -%}
          {%- capture r_mn %}{% render 'plan-price', tier: 'selecto', kind: 'meal' %}{% endcapture -%}
          {%- assign r_bn = r_bn | strip | plus: 0 -%}{%- assign r_wn = r_wn | strip | plus: 0 -%}{%- assign r_mn = r_mn | strip | plus: 0 -%}
          {%- assign r_block = r_bn | times: 100 | money_without_trailing_zeros -%}
          {%- assign r_week = r_wn | times: 100 | money_without_trailing_zeros -%}
          {%- assign r_meal = r_mn | times: 100 | money_without_trailing_zeros -%}
          {%- assign r_wk = r_bn | divided_by: 4 | times: 100 | money_without_trailing_zeros -%}
          <div class="fn-rules" data-fn-rules>
            <div class="fn-rules__head"><h3 class="fn-rules__title">{{ 'funnel.rules_title' | t }}</h3>{% render 'service-badge' %}</div>
            <div class="fn-rules__carousel">
              <button class="fn-arrow fn-arrow--prev" type="button" data-fn-rules-arrow="-1" aria-label="{{ 'funnel.prev_dishes' | t }}">&#8249;</button>
              <div class="fn-rules__rail" data-fn-rules-rail>
                {%- comment -%} The guide: four steps for visitors, three once they are signed in (the sign-in step is gone) {%- endcomment -%}
                <article class="fn-rcard fn-rg">
                  <p class="fn-rg__lab">{{ 'funnel.rg_l1' | t }}</p>
                  <p class="fn-rg__p">{{ 'funnel.rg1_p_html' | t }}</p>
                  <div class="fn-rg__opts"><div class="fn-rg__opt"><p>{{ 'funnel.rg1_a_html' | t }}</p></div><div class="fn-rg__opt"><p>{{ 'funnel.rg1_b_html' | t }}</p></div></div>
                </article>
                <article class="fn-rcard fn-rg">
                  <p class="fn-rg__lab">{{ 'funnel.rg_l2' | t }}</p>
                  <p class="fn-rg__p">{{ 'funnel.rg2_p' | t }}</p>
                  <p class="fn-rg__q">{{ 'funnel.rg2_q' | t }}</p>
                  <p class="fn-rg__note">{{ 'funnel.rg2_n' | t }}</p>
                </article>
                <article class="fn-rcard fn-rg fn-rg--ex"{% if customer %} data-fn-rules-last{% endif %}>
                  <p class="fn-rg__lab">{{ 'funnel.rg_l3' | t }}</p>
                  <p class="fn-rg__p">{{ 'funnel.rg3_p_html' | t }}</p>
                  <div class="fn-ex">
                    <div class="fn-ex__card">
                      <h5>{{ 'funnel.rg3_c_t' | t }}<small>{{ 'funnel.rg3_c_s' | t }}</small></h5>
                      <div class="fn-ex__bar"><i class="is-glow">{{ 'funnel.rg3_c_bar' | t }}</i></div>
                      <p class="fn-ex__m">{{ 'funnel.rg3_c_m' | t }}</p>
                      <p class="fn-ex__ok"><span aria-hidden="true">&#10003;</span>{{ 'funnel.rg3_c_ok' | t }}</p>
                    </div>
                    <div class="fn-ex__card">
                      <h5>{{ 'funnel.rg3_p_t' | t }}<small>{{ 'funnel.rg3_p_s' | t }}</small></h5>
                      <div class="fn-ex__bar"><i class="is-base">{{ 'funnel.rg3_p_bar1' | t }}</i><i class="is-extra">{{ 'funnel.rg3_p_bar2' | t }}</i></div>
                      <p class="fn-ex__m2"><span>{{ 'funnel.rg3_p_m1' | t }}</span><span>{{ 'funnel.rg3_p_m2' | t }}</span></p>
                      <p class="fn-ex__tot">{{ 'funnel.rg3_p_tot' | t }}</p>
                      <p class="fn-ex__pay"><span aria-hidden="true">&rarr;</span><b>{{ 'funnel.rg3_p_pay' | t }}</b></p>
                    </div>
                  </div>
                </article>
                {%- unless customer -%}
                <article class="fn-rcard fn-rg fn-rg--signin" data-fn-rules-signin data-fn-rules-last>
                  <p class="fn-rg__lab">{{ 'funnel.rg_l4' | t }}</p>
                  <div class="fn-su">
                    <h4>{{ 'funnel.rg4_t' | t }}</h4>
                    <ul><li>{{ 'funnel.rg4_b1' | t }}</li><li>{{ 'funnel.rg4_b2' | t }}</li><li>{{ 'funnel.rg4_b3' | t }}</li></ul>
                    <a class="btn btn--gold fn-su__btn" href="{% render 'login-url', back: '/pages/bienvenida' %}">{{ 'login.enter' | t }}</a>
                  </div>
                </article>
                {%- endunless -%}
                <article class="fn-rcard fn-rcard--final" data-fn-rules-final><b class="fn-rules__n">&#10003;</b><h4>{{ 'funnel.rules_final_t' | t }}</h4><div data-fn-rules-slot></div></article>
              </div>
              <button class="fn-arrow fn-arrow--next" type="button" data-fn-rules-arrow="1" aria-label="{{ 'funnel.next_dishes' | t }}">&#8250;</button>
            </div>
            <div class="fn-rules__end" data-fn-rules-end>
              <p class="fn-rules__hint" data-fn-rules-hint>{{ 'funnel.rules_scroll' | t }} &rarr;</p>
              <label class="check fn-rules__check"><input type="checkbox" data-fn-rules-check disabled> <span>{{ 'funnel.rules_check' | t }}</span></label>
              <button class="btn btn--gold" type="button" data-fn-rules-next disabled>{{ 'funnel.rules_next' | t }} &rarr;</button>
            </div>
          </div>
        </fieldset>
        <fieldset class="step" data-fn-step="1">
          <legend class="fn-sr">{{ 'funnel.s1_title' | t }}</legend>
          <div class="fn-credit" data-fn-credit hidden><p data-fn-credit-text></p><a class="btn btn--outline btn--sm" href="/pages/cuenta-semana" data-fn-credit-link>{{ 'funnel.credit_cta' | t }}</a></div>
          <div class="fn-pickgrid">
            <div class="fn-pickcol">
              <h3 class="fn-pickh"><b>1</b>{{ 'funnel.p1_h' | t }}</h3>
              <div class="fn-cats" data-fn-cats role="radiogroup" aria-label="{{ 'funnel.p1_h' | t }}">
                {%- assign fn_cats = 'keto-low-carb,fit-proteina,veggie,sin-gluten,ligero,al-fuego,bowls,desayunos,diario,entradas,snacks-postres,junior,all' | split: ',' -%}
                {%- for c in fn_cats -%}{%- assign ck = c | replace: '-', '_' -%}{%- assign ckt = 'funnel.cat_' | append: ck -%}{%- assign cks = ckt | append: '_s' -%}
                <button class="fn-cat" type="button" role="radio" aria-checked="false" data-cat-choice="{{ c }}">
                  <span class="fn-cat__tag">{{ 'funnel.cat_sel' | t }} &#9733;</span>
                  <i class="fn-cat__ico"><svg class="fn-cat__svg" viewBox="0 0 48 48" width="56" height="56" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- case c -%}
  {%- when 'keto-low-carb' -%}<path d="M24 5c-5 7-12 12-12 22a12 12 0 0 0 24 0C36 17 29 12 24 5z"/><circle cx="24" cy="29" r="5.5"/>
  {%- when 'al-fuego' -%}<path d="M25 4c1.5 8 11 12 11 24a12 12 0 0 1-24 0c0-6 3-9 6-12 0 4 2 6 4 7 1-6 1-12 3-19z"/><path d="M24 44c-4 0-6-3-6-6 0-4 4-6 6-10 2 3 6 6 6 10 0 3-2 6-6 6z"/>
  {%- when 'fit-proteina' -%}<path d="M6 20v8M12 15v18M36 15v18M42 20v8M12 24h24"/>
  {%- when 'veggie' -%}<path d="M8 40C8 20 20 8 40 8c0 20-12 32-32 32z"/><path d="M8 40 28 20"/>
  {%- when 'sin-gluten' -%}<path d="M24 42V14M24 14c-5 0-8-3-8-7 5 0 8 3 8 7zM24 14c5 0 8-3 8-7-5 0-8 3-8 7zM24 24c-5 0-8-3-8-7 5 0 8 3 8 7zM24 24c5 0 8-3 8-7-5 0-8 3-8 7zM24 34c-5 0-8-3-8-7 5 0 8 3 8 7zM24 34c5 0 8-3 8-7-5 0-8 3-8 7z"/><path d="M8 8l32 32"/>
  {%- when 'bowls' -%}<path d="M6 22h36a18 18 0 0 1-36 0z"/><path d="M16 14c0-4 4-4 4-8M26 14c0-4 4-4 4-8"/><path d="M14 42h20"/>
  {%- when 'desayunos' -%}<path d="M6 34h36"/><path d="M12 34a12 12 0 0 1 24 0"/><path d="M24 12v6M10 18l4 4M38 18l-4 4"/>
  {%- when 'diario' -%}<rect x="9" y="10" width="30" height="28" rx="4"/><path d="M9 20h30M17 6v8M31 6v8"/><path d="M17 28h6M26 28h6"/>
  {%- when 'junior' -%}<circle cx="24" cy="24" r="16"/><circle cx="18" cy="21" r="1.6"/><circle cx="30" cy="21" r="1.6"/><path d="M16 29c2 4 14 4 16 0"/>
  {%- when 'entradas' -%}<path d="M8 28h32c0 7-7 12-16 12S8 35 8 28z"/><path d="M33 7l-6 15"/><ellipse cx="35" cy="10" rx="3" ry="4.5" transform="rotate(22 35 10)"/>
  {%- when 'snacks-postres' -%}<path d="M12 22h24l-3 18H15z"/><path d="M12 22a12 10 0 0 1 24 0"/><circle cx="24" cy="9" r="2.2"/>
  {%- when 'ligero' -%}<path d="M8 32a16 16 0 0 1 32 0"/><path d="M24 32l7-10"/><circle cx="24" cy="32" r="2.4"/><path d="M12 41h24"/>
  {%- else -%}<path d="M24 6l4 12 12 4-12 4-4 12-4-12-12-4 12-4z"/><path d="M38 34l1.5 4 4 1.5-4 1.5-1.5 4-1.5-4-4-1.5 4-1.5z"/>
{%- endcase -%}
</svg></i>
                  <strong>{{ ckt | t }}</strong><small>{{ cks | t }}</small>
                </button>
                {%- endfor -%}
              </div>
              <div class="fn-cats__ctl"><button class="fn-cats__a" type="button" data-fn-cats-arrow="-1" aria-label="{{ 'funnel.prev_dishes' | t }}">&#8249;</button><button class="fn-cats__a" type="button" data-fn-cats-arrow="1" aria-label="{{ 'funnel.next_dishes' | t }}">&#8250;</button><span>{{ 'funnel.cats_hint' | t }}</span></div>
            </div>
            <div class="fn-pickcol">
              <h3 class="fn-pickh"><b>2</b>{{ 'funnel.p2_h' | t }}</h3>
              <div class="fn-plans" role="radiogroup" aria-label="{{ 'funnel.p2_h' | t }}">
                <button class="fn-plan" type="button" role="radio" data-plan-choice="block" aria-checked="true">
                  <span class="fn-plan__tag">{{ 'funnel.pl_block_tag' | t }}</span>
                  <strong>{{ 'funnel.plan_block' | t }}</strong>
                  <em class="fn-plan__from">{{ 'funnel.pl_from' | t }} <b>{{ st_meal_m }}</b> {{ 'funnel.pl_day' | t }}</em>
                  <small>{{ 'funnel.pl_wk' | t | replace: '[w]', st_bwk_m }}</small>
                  <ul class="fn-plan__ul"><li>{{ 'funnel.pl_b1' | t }}</li><li>{{ 'funnel.pl_b2' | t | replace: '[b]', st_blk_m }}</li><li>{{ 'funnel.pl_b3' | t }}</li></ul>
                </button>
                <button class="fn-plan" type="button" role="radio" data-plan-choice="week" aria-checked="false">
                  <strong>{{ 'funnel.plan_week' | t }}</strong>
                  <em class="fn-plan__from"><b>{{ st_day_m }}</b> {{ 'funnel.pl_day' | t }}</em>
                  <small>{{ 'funnel.pl_wk_total' | t | replace: '[w]', st_week_m }}</small>
                  <ul class="fn-plan__ul"><li>{{ 'funnel.pl_b1' | t }}</li><li>{{ 'funnel.pl_w_b2' | t }}</li></ul>
                </button>
              </div>
              <label class="check fn-renew" data-fn-renew hidden><input type="checkbox" data-fn-renew-box checked> <span>{{ 'funnel.renew' | t }}</span></label>
            </div>
          </div>
          <div class="fn-pickfoot"><button class="text-link" type="button" data-fn-own>{{ 'funnel.own_q' | t }}</button><button class="btn btn--gold fn-pickgo" type="button" data-fn-go-next disabled>{{ 'funnel.go' | t }} &rarr;</button></div>
        </fieldset>

        <div class="fn-tierdata" data-fn-tierdata hidden aria-hidden="true">
            {%- liquid
              assign pp_selecto = nil
              for pp in plan_coll.products
                if pp.metafields.kulinaria.tier.value == 'selecto'
                  assign pp_selecto = pp
                endif
              endfor
            -%}
