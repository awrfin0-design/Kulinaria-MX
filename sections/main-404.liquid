<section class="section surface-walnut" style="min-height:60vh;display:grid;place-items:center" {{ section.shopify_attributes }}>
  <div class="container" style="text-align:center">
    <p class="eyebrow">{{ 'e404.code' | t }}</p>
    <h1>{{ 'e404.title' | t }}</h1>
    <div class="divider-gold" style="margin-inline:auto"><i></i></div>
    <p class="lede" style="margin-inline:auto">{{ 'e404.text' | t }}</p>
    <div class="btn-row" style="justify-content:center">
      <a class="btn btn--gold" href="/collections/menu-semanal">{{ 'general.view_menu' | t }}</a>
      <a class="btn btn--outline" href="{{ routes.root_url }}">{{ 'general.go_home' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
