<section class="section{% if section.settings.bg_video %} tiers--video tone-dark{% endif %}" {{ section.shopify_attributes }}>
  {%- if section.settings.bg_video -%}
    <div class="tiers__bg" aria-hidden="true">
      <video class="tiers__video" muted loop playsinline preload="none" poster="{{ 'video-hero-dark-poster.webp' | asset_url }}" data-video-src="{{ 'video-hero-dark.mp4' | asset_url }}" data-ambient></video>
    </div>
  {%- endif -%}
  <div class="container">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{% render 'headline', text: section.settings.heading %}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="tier-ladder">
      {%- for block in section.blocks -%}
        <article class="tier-row tier-row--{{ block.settings.tier }}" {{ block.shopify_attributes }}>
          <span class="tier-row__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div>{% render 'tier-badge', tier: block.settings.tier %}</div>
          <p class="tier-row__text">{{ block.settings.text }}</p>
          <p class="tier-row__price gold-text">{% render 'plan-price', tier: block.settings.tier, kind: 'meal', money: true %}<small>{{ 'tiers.unit' | t }}</small></p>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="text-muted" style="margin-top:var(--space-lg)">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Niveles del menú",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Niveles" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Cuatro niveles, un mismo estándar" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Cada nivel suma $70 MXN por comida sobre el anterior. El precio incluye el empaque óptimo y la preparación del chef." },
    { "type": "checkbox", "id": "bg_video", "label": "Video de fondo (el filete en el aire)", "default": false },
    { "type": "text", "id": "note", "label": "Nota al pie", "default": "Los precios se muestran por platillo. Se editan en Personalizar tema, Niveles y precios." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Nivel",
      "settings": [
        { "type": "select", "id": "tier", "label": "Nivel", "default": "selecto", "options": [
          { "value": "selecto", "label": "Selecto" }, { "value": "exclusivo", "label": "Exclusivo ($)" },
          { "value": "signature", "label": "Signature ($$)" }, { "value": "reserve", "label": "Reserve ($$$)" } ] },
        { "type": "textarea", "id": "text", "label": "Descripción", "default": "Menú base diario y de alta rotación." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Niveles del menú",
      "blocks": [
        { "type": "tier", "settings": { "tier": "selecto", "text": "Nuestro menú base diario: cocina saludable, balanceada y dietas adaptables con pollo, cerdo o res magra." } },
        { "type": "tier", "settings": { "tier": "exclusivo", "text": "Cocciones más lentas y elaboraciones sofisticadas: costras de frutos secos y reducciones artesanales." } },
        { "type": "tier", "settings": { "tier": "signature", "text": "Recetas con sello de autor: cortes premium e ingredientes de temporada." } },
        { "type": "tier", "settings": { "tier": "reserve", "text": "La máxima gama: cortes Prime y mariscos selectos, acondicionados para recalentar." } }
      ]
    }
  ]
}
{% endschema %}
