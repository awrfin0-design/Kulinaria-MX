{%- capture tx_disclaimer -%}{% render 'tx', s: settings.allergy_disclaimer %}{%- endcapture -%}
{%- liquid
  assign allergy_list = 'Gluten,Lácteos,Frutos secos,Cacahuate,Mariscos,Pescado,Huevo,Soya,Ajonjolí,Apio,Mostaza,Sulfitos' | split: ','
  assign diet_list = 'Keto,Libre de gluten,Vegetariano,Vegano' | split: ','
  assign sug_dis = 'onboarding.ob_sug_dis' | t | split: ','
  assign sug_al = 'onboarding.ob_sug_al' | t | split: ','
  assign sug_love = 'onboarding.ob_sug_love' | t | split: ','
  assign meals = 'desayunos|ob_m_b,comidas|ob_m_l,cenas|ob_m_d,snacks|ob_m_s,postres|ob_m_p' | split: ','
  assign conds = 'diabetes|ob_c_dia,hipertension|ob_c_hyp,celiaquia|ob_c_cel,embarazo|ob_c_pre,colesterol|ob_c_col,ninguna|ob_c_none' | split: ','
  assign cuis = 'mexicana|ob_q_mx,mediterranea|ob_q_med,asiatica|ob_q_asia,italiana|ob_q_it,brasa|ob_q_grill,huerto|ob_q_veg' | split: ','
  assign s_window = 'any|ob_w_any,am|ob_w_am,pm|ob_w_pm,eve|ob_w_eve' | split: ','
  assign s_portion = 'ligera|ob_p_light,normal|ob_p_normal,abundante|ob_p_big' | split: ','
  assign s_activity = 'poca|ob_a_low,moderada|ob_a_mid,alta|ob_a_high' | split: ','
  assign s_sev = 'leve|ob_sev_1,fuerte|ob_sev_2,anafilaxia|ob_sev_3' | split: ','
  assign s_cross = 'tolera|ob_x_ok,estricto|ob_x_strict' | split: ','
  assign s_spice = '0|ob_sp_0,1|ob_sp_1,2|ob_sp_2,3|ob_sp_3' | split: ','
  assign s_contact = 'correo|ob_ct_mail,whatsapp|ob_ct_wa,ambos|ob_ct_both' | split: ','
-%}
<section class="section onboarding" data-onboarding data-next-url="{{ section.settings.next_url | default: '/pages/pedido' }}"
  {%- if customer %} data-customer-name="{{ customer.name | escape }}" data-customer-email="{{ customer.email | escape }}"{% endif %}
  data-t-welcome="{{ 'onboarding.welcome' | t }}" data-t-need-addr="{{ 'onboarding.ob_need_addr' | t }}" data-t-need-consent="{{ 'onboarding.ob_need_consent' | t }}" data-t-need="{{ 'onboarding.need' | t }}"
  data-zip-prefixes="{{ settings.service_zip_prefixes | default: '72' | escape }}" data-t-out="{{ 'service.out' | t }}" data-t-stepof="{{ 'onboarding.stepof' | t }}" data-t-edit="{{ 'onboarding.ob_review_edit' | t }}" data-t-empty="{{ 'onboarding.ob_review_empty' | t }}" {{ section.shopify_attributes }}>
  <div class="container ob-wrap">
    <a hidden tabindex="-1" aria-hidden="true" data-ob-week href="/pages/cuenta-semana"></a>
    {%- unless customer -%}
      <div class="ob-guest" data-ob-guest>
        <span class="ob-flame" aria-hidden="true"></span>
        <h2>{{ 'onboarding.guest_title' | t }}</h2>
        <p class="text-muted">{{ 'onboarding.guest_text' | t }}</p>
        <div class="btn-row">
          <a class="btn btn--gold" href="{% render 'login-url', back: '/pages/bienvenida' %}">{{ 'login.enter' | t }}</a>
          
        </div>
      </div>
    {%- endunless -%}

    <div class="ob-welcome" data-ob-welcome hidden>
      <span class="ob-flame" aria-hidden="true"></span>
      <p class="eyebrow">{{ 'onboarding.done_eyebrow' | t }}</p>
      <h2 data-ob-hello>{{ 'onboarding.done_title' | t }}</h2>
      <p class="lede">{{ 'onboarding.done_text' | t }}</p>
      <ol class="ob-next">
        <li>{{ 'onboarding.next1' | t }}</li><li>{{ 'onboarding.next2' | t }}</li><li>{{ 'onboarding.next3' | t }}</li>
      </ol>
      <div class="btn-row"><a class="btn btn--gold" href="{{ section.settings.next_url | default: '/pages/pedido' }}">{{ 'onboarding.choose_plan' | t }}</a><button class="btn btn--outline" type="button" data-ob-edit>{{ 'onboarding.edit' | t }}</button></div>
    </div>

    <form class="ob" data-ob-form novalidate {% unless customer %}hidden{% endunless %}>
      <aside class="ob-side">
        <p class="eyebrow">{{ 'onboarding.eyebrow' | t }}</p>
        <h2>{{ 'onboarding.side_title' | t }}</h2>
        <p class="ob-side__text">{{ 'onboarding.side_text' | t }}</p>
        <ol class="ob-dots">
          {%- for n in (1..6) -%}
            {%- assign nk = 'onboarding.n' | append: n -%}{%- assign wk = 'onboarding.why' | append: n -%}
            <li{% if n == 1 %} class="is-on"{% endif %} data-ob-nav="{{ n }}"><b>0{{ n }}</b><span class="ob-dots__t">{{ nk | t }}</span><span class="ob-dots__why">{{ wk | t }}</span></li>
          {%- endfor -%}
        </ol>
        <p class="ob-side__secure">{{ 'onboarding.secure' | t }}</p>
      </aside>

      <div class="ob-card">
        <div class="ob-bar" aria-hidden="true"><i data-ob-bar></i></div>
        <p class="ob-count" data-ob-count></p>
        <h2 class="ob-title">{{ 'onboarding.title' | t }}</h2>

        <fieldset class="step is-on" data-ob-step="1">
          <legend>{{ 'onboarding.s1' | t }}</legend>
          <div class="form-grid">
            <div class="field"><label for="ob-name">{{ 'form.full_name' | t }}</label><input class="input" id="ob-name" data-ob="name" autocomplete="name"></div>
            <div class="field"><label for="ob-email">{{ 'form.email' | t }}</label><input class="input" id="ob-email" type="email" data-ob="email" autocomplete="email"></div>
            <div class="field"><label for="ob-phone">{{ 'form.phone_whatsapp' | t }}</label><input class="input" id="ob-phone" type="tel" data-ob="phone" autocomplete="tel"></div>
            <div class="field"><label for="ob-birth">{{ 'onboarding.ob_birth' | t }}</label><input class="input" id="ob-birth" type="date" data-ob="birth" autocomplete="bday"></div>
          </div>
        </fieldset>

        <fieldset class="step" data-ob-step="2">
          <legend>{{ 'onboarding.s2' | t }}</legend>
          <p class="svc-note">{{ 'service.form_note' | t }}</p>
          <div class="form-grid">
            <div class="field"><label for="ob-street">{{ 'addr.street' | t }}</label><input class="input" id="ob-street" data-ob="street" autocomplete="address-line1"></div>
            <div class="field"><label for="ob-num">{{ 'onboarding.ob_num' | t }}</label><input class="input" id="ob-num" data-ob="num" autocomplete="address-line2"></div>
            <div class="field"><label for="ob-cluster">{{ 'addr.cluster' | t }}</label><input class="input" id="ob-cluster" data-ob="cluster"></div>
            <div class="field"><label for="ob-city">{{ 'onboarding.ob_city' | t }}</label><input class="input" id="ob-city" data-ob="city" autocomplete="address-level2"></div>
            <div class="field"><label for="ob-zip">{{ 'addr.zip' | t }}</label><input class="input" id="ob-zip" data-ob="zip" autocomplete="postal-code" inputmode="numeric"></div>
            <div class="field"><label for="ob-refs">{{ 'onboarding.ob_refs' | t }}</label><input class="input" id="ob-refs" data-ob="refs"></div>
          </div>
          <div class="field"><label for="ob-access">{{ 'onboarding.ob_access' | t }}</label><input class="input" id="ob-access" data-ob="access"></div>
          <p class="label">{{ 'onboarding.ob_window' | t }}</p>
          <div class="seg" data-ob-seg="window">
            {%- for o in s_window -%}{%- assign op = o | split: '|' -%}{%- assign ok = 'onboarding.' | append: op[1] -%}
              <label class="seg__o"><input type="radio" name="ob-window" value="{{ op[0] }}"><span>{{ ok | t }}</span></label>
            {%- endfor -%}
          </div>
        </fieldset>

        <fieldset class="step" data-ob-step="3">
          <legend>{{ 'onboarding.s3' | t }}</legend>
          <p class="label">{{ 'onboarding.ob_people' | t }}</p>
          <div class="ob-people">
            <div class="counter"><span>{{ 'onboarding.ob_adults' | t }}</span>
              <button type="button" class="counter__b" data-ob-count-btn="adults" data-d="-1" aria-label="-">&minus;</button>
              <input class="counter__v" id="ob-adults" type="number" min="1" max="12" inputmode="numeric" data-ob="adults" value="1" aria-label="{{ 'onboarding.ob_adults' | t }}">
              <button type="button" class="counter__b" data-ob-count-btn="adults" data-d="1" aria-label="+">+</button></div>
            <div class="counter"><span>{{ 'onboarding.ob_kids' | t }}</span>
              <button type="button" class="counter__b" data-ob-count-btn="kids" data-d="-1" aria-label="-">&minus;</button>
              <input class="counter__v" id="ob-kids" type="number" min="0" max="12" inputmode="numeric" data-ob="kids" value="0" aria-label="{{ 'onboarding.ob_kids' | t }}">
              <button type="button" class="counter__b" data-ob-count-btn="kids" data-d="1" aria-label="+">+</button></div>
          </div>
          <p class="legal-note">{{ 'onboarding.ob_people_note' | t }}</p>
          <p class="label">{{ 'onboarding.ob_meals' | t }}</p>
          <div class="pills">
            {%- for m in meals -%}{%- assign mp = m | split: '|' -%}{%- assign mk = 'onboarding.' | append: mp[1] -%}
              <label class="pill"><input type="checkbox" data-ob-group="meals" value="{{ mp[0] }}"><span>{{ mk | t }}</span></label>
            {%- endfor -%}
          </div>
          <p class="label">{{ 'onboarding.ob_portion' | t }}</p>
          <div class="seg" data-ob-seg="portion">
            {%- for o in s_portion -%}{%- assign op = o | split: '|' -%}{%- assign ok = 'onboarding.' | append: op[1] -%}
              <label class="seg__o"><input type="radio" name="ob-portion" value="{{ op[0] }}"><span>{{ ok | t }}</span></label>
            {%- endfor -%}
          </div>
          <p class="label">{{ 'onboarding.ob_activity' | t }}</p>
          <div class="seg" data-ob-seg="activity">
            {%- for o in s_activity -%}{%- assign op = o | split: '|' -%}{%- assign ok = 'onboarding.' | append: op[1] -%}
              <label class="seg__o"><input type="radio" name="ob-activity" value="{{ op[0] }}"><span>{{ ok | t }}</span></label>
            {%- endfor -%}
          </div>
        </fieldset>

        <fieldset class="step" data-ob-step="4">
          <legend>{{ 'onboarding.s4' | t }}</legend>
          <p class="label">{{ 'profile.block1' | t }}</p>
          <div class="pills pills--al">
            {%- for a in allergy_list -%}{%- assign ah = a | handleize -%}{%- assign ak = 'allergen.' | append: ah -%}
              <label class="pill"><input type="checkbox" data-ob-allergy value="{{ a }}"><span>{{ ak | t }}</span></label>
            {%- endfor -%}
          </div>
          <p class="label">{{ 'onboarding.ob_other_al' | t }}</p>
          <div class="tags" data-ob-tags="allergy_other">
            <div class="tag-input"><input type="text" data-ob-tag-input placeholder="{{ 'onboarding.ob_tag_hint' | t }}" aria-label="{{ 'onboarding.ob_other_al' | t }}"></div>
            <input type="hidden" data-ob="allergy_other">
            <div class="chips chips--sug">{%- for s in sug_al -%}<button class="chip" type="button" data-ob-suggest="{{ s }}">+ {{ s }}</button>{%- endfor -%}</div>
          </div>
          <p class="label">{{ 'onboarding.ob_sev' | t }}</p>
          <div class="seg" data-ob-seg="severity">
            {%- for o in s_sev -%}{%- assign op = o | split: '|' -%}{%- assign ok = 'onboarding.' | append: op[1] -%}
              <label class="seg__o"><input type="radio" name="ob-severity" value="{{ op[0] }}"><span>{{ ok | t }}</span></label>
            {%- endfor -%}
          </div>
          <p class="label">{{ 'onboarding.ob_cross' | t }}</p>
          <div class="seg" data-ob-seg="cross">
            {%- for o in s_cross -%}{%- assign op = o | split: '|' -%}{%- assign ok = 'onboarding.' | append: op[1] -%}
              <label class="seg__o"><input type="radio" name="ob-cross" value="{{ op[0] }}"><span>{{ ok | t }}</span></label>
            {%- endfor -%}
          </div>
          <p class="label">{{ 'onboarding.ob_cond' | t }}</p>
          <div class="pills">
            {%- for c in conds -%}{%- assign cp = c | split: '|' -%}{%- assign ck = 'onboarding.' | append: cp[1] -%}
              <label class="pill"><input type="checkbox" data-ob-group="conditions" value="{{ cp[0] }}"><span>{{ ck | t }}</span></label>
            {%- endfor -%}
          </div>
          <p class="legal-note">{{ tx_disclaimer }}</p>
        </fieldset>

        <fieldset class="step" data-ob-step="5">
          <legend>{{ 'onboarding.s5' | t }}</legend>
          <p class="label">{{ 'profile.diets' | t }}</p>
          <div class="pills">
            {%- for d in diet_list -%}{%- assign dh = d | handleize -%}{%- assign dk = 'diet.' | append: dh -%}
              <label class="pill"><input type="checkbox" data-ob-diet value="{{ d }}"><span>{{ dk | t }}</span></label>
            {%- endfor -%}
            <label class="pill"><input type="checkbox" data-ob-diet value="Bajo en carbohidratos"><span>{{ 'onboarding.ob_d_lowcarb' | t }}</span></label>
            <label class="pill"><input type="checkbox" data-ob-diet value="Alto en proteína"><span>{{ 'onboarding.ob_d_protein' | t }}</span></label>
          </div>
          <p class="label">{{ 'onboarding.ob_dislikes' | t }}</p>
          <div class="tags" data-ob-tags="dislikes">
            <div class="tag-input"><input type="text" data-ob-tag-input placeholder="{{ 'onboarding.ob_tag_hint' | t }}" aria-label="{{ 'onboarding.ob_dislikes' | t }}"></div>
            <input type="hidden" data-ob="dislikes">
            <div class="chips chips--sug">{%- for s in sug_dis -%}<button class="chip" type="button" data-ob-suggest="{{ s }}">+ {{ s }}</button>{%- endfor -%}</div>
          </div>
          <p class="label">{{ 'onboarding.ob_loves' | t }}</p>
          <div class="tags" data-ob-tags="loves">
            <div class="tag-input"><input type="text" data-ob-tag-input placeholder="{{ 'onboarding.ob_tag_hint' | t }}" aria-label="{{ 'onboarding.ob_loves' | t }}"></div>
            <input type="hidden" data-ob="loves">
            <div class="chips chips--sug">{%- for s in sug_love -%}<button class="chip" type="button" data-ob-suggest="{{ s }}">+ {{ s }}</button>{%- endfor -%}</div>
          </div>
          <p class="label">{{ 'onboarding.ob_cuisines' | t }}</p>
          <div class="pills">
            {%- for c in cuis -%}{%- assign cp = c | split: '|' -%}{%- assign ck = 'onboarding.' | append: cp[1] -%}
              <label class="pill"><input type="checkbox" data-ob-group="cuisines" value="{{ cp[0] }}"><span>{{ ck | t }}</span></label>
            {%- endfor -%}
          </div>
          <p class="label">{{ 'onboarding.ob_spice' | t }}</p>
          <div class="seg" data-ob-seg="spice">
            {%- for o in s_spice -%}{%- assign op = o | split: '|' -%}{%- assign ok = 'onboarding.' | append: op[1] -%}
              <label class="seg__o"><input type="radio" name="ob-spice" value="{{ op[0] }}"><span>{{ ok | t }}</span></label>
            {%- endfor -%}
          </div>
          <div class="form-grid">
            <div class="field"><label for="ob-goal">{{ 'onboarding.ob_goal' | t }}</label><select class="select" id="ob-goal" data-ob="goal"><option value="">{{ 'onboarding.ob_pick' | t }}</option><option value="mejor">{{ 'onboarding.ob_g_any' | t }}</option><option value="bajar">{{ 'onboarding.ob_g_lose' | t }}</option><option value="musculo">{{ 'onboarding.ob_g_gain' | t }}</option><option value="mantener">{{ 'onboarding.ob_g_keep' | t }}</option><option value="deporte">{{ 'onboarding.ob_g_sport' | t }}</option></select></div>
            <div class="field"><label for="ob-kcal">{{ 'onboarding.ob_kcal' | t }}</label><input class="input" id="ob-kcal" type="number" min="800" max="6000" inputmode="numeric" data-ob="kcal"></div>
          </div>
        </fieldset>

        <fieldset class="step" data-ob-step="6">
          <legend>{{ 'onboarding.s6' | t }}</legend>
          <p class="text-muted">{{ 'onboarding.ob_review_hint' | t }}</p>
          <div class="review" data-ob-review></div>
          <p class="label">{{ 'onboarding.ob_extra' | t }}</p>
          <div class="form-grid">
            <div class="field"><label for="ob-ref">{{ 'onboarding.ob_ref' | t }}</label><input class="input" id="ob-ref" data-ob="ref" autocapitalize="characters"></div>
            <div class="field"><label for="ob-heard">{{ 'onboarding.ob_heard' | t }}</label><select class="select" id="ob-heard" data-ob="heard"><option value="">{{ 'onboarding.ob_pick' | t }}</option><option value="instagram">{{ 'onboarding.ob_h_ig' | t }}</option><option value="amigos">{{ 'onboarding.ob_h_friend' | t }}</option><option value="gym">{{ 'onboarding.ob_h_gym' | t }}</option><option value="web">{{ 'onboarding.ob_h_web' | t }}</option><option value="otro">{{ 'onboarding.ob_h_other' | t }}</option></select></div>
          </div>
          <p class="label">{{ 'onboarding.ob_contact' | t }}</p>
          <div class="seg" data-ob-seg="contact">
            {%- for o in s_contact -%}{%- assign op = o | split: '|' -%}{%- assign ok = 'onboarding.' | append: op[1] -%}
              <label class="seg__o"><input type="radio" name="ob-contact" value="{{ op[0] }}"><span>{{ ok | t }}</span></label>
            {%- endfor -%}
          </div>
          <p class="label">{{ 'onboarding.ob_confirm' | t }}</p>
          <label class="check check--box"><input type="checkbox" data-ob-consent> <span>{{ 'onboarding.ob_c1' | t }}</span></label>
          <label class="check check--box"><input type="checkbox" data-ob-consent> <span>{{ 'onboarding.ob_c2' | t }}</span></label>
          <label class="check check--box"><input type="checkbox" data-ob-consent> <span>{{ 'onboarding.ob_c3' | t }}</span></label>
        </fieldset>

        <p class="alert alert--warn" data-ob-error hidden role="alert"></p>
        <div class="steps__actions">
          <button class="text-link" type="button" data-ob-prev hidden>{{ 'funnel.back' | t }}</button>
          <button class="btn btn--gold" type="button" data-ob-next>{{ 'funnel.next' | t }}</button>
          <button class="btn btn--gold" type="submit" data-ob-save hidden>{{ 'onboarding.save' | t }}</button>
        </div>
      </div>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Bienvenida",
  "settings": [
    { "type": "text", "id": "next_url", "label": "Después del cuestionario ir a", "default": "/pages/pedido" }
  ],
  "presets": [{ "name": "Bienvenida" }]
}
{% endschema %}
