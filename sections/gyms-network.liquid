{%- capture tx_tag -%}{% render 'tx', s: section.settings.tag %}{%- endcapture -%}
{%- capture tx_h -%}{% render 'tx', s: section.settings.heading %}{%- endcapture -%}
{%- capture tx_hem -%}{% render 'tx', s: section.settings.heading_em %}{%- endcapture -%}
{%- capture tx_p -%}{% render 'tx', s: section.settings.text %}{%- endcapture -%}
{%- capture tx_b1 -%}{% render 'tx', s: section.settings.btn1_label %}{%- endcapture -%}
{%- capture tx_b2 -%}{% render 'tx', s: section.settings.btn2_label %}{%- endcapture -%}
{%- capture tx_mb -%}{% render 'tx', s: section.settings.map_button %}{%- endcapture -%}
{%- capture tx_zone -%}{% render 'tx', s: section.settings.zone %}{%- endcapture -%}
{%- capture tx_lt -%}{% render 'tx', s: section.settings.logos_title %}{%- endcapture -%}
{%- capture tx_at -%}{% render 'tx', s: section.settings.affil_tag %}{%- endcapture -%}
{%- capture tx_ah -%}{% render 'tx', s: section.settings.affil_title %}{%- endcapture -%}
{%- capture tx_ax -%}{% render 'tx', s: section.settings.affil_text %}{%- endcapture -%}
{%- capture tx_ab -%}{% render 'tx', s: section.settings.affil_btn %}{%- endcapture -%}
<section class="section gy" data-no-wordmark data-scroll {{ section.shopify_attributes }}>
  <div class="container">
    <div class="gy__top tone-dark">
      <div class="gy__copy">
        {%- if tx_tag != blank -%}<span class="gy__tag">{{ tx_tag }}</span>{%- endif -%}
        <h2 class="gy__h">{{ tx_h }} {%- if tx_hem != blank %} <em>{{ tx_hem }}</em>{% endif -%}</h2>
        {%- if tx_p != blank -%}<p class="gy__p">{{ tx_p }}</p>{%- endif -%}
        <div class="gy__cta">
          {%- if tx_b1 != blank -%}<a class="gy__btn gy__btn--solid" href="{{ section.settings.btn1_link | default: '/pages/embajadores-gimnasios' }}">{{ tx_b1 }}<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{%- endif -%}
          {%- if tx_b2 != blank -%}<a class="gy__btn gy__btn--line" href="{{ section.settings.btn2_link | default: 'dialog:gimnasio~Afiliar gimnasio' }}">{{ tx_b2 }}</a>{%- endif -%}
        </div>
      </div>
      <div class="gy__map gy__map--live" data-gymmap data-lat="{{ section.settings.map_lat | default: '19.03' }}" data-lng="{{ section.settings.map_lng | default: '-98.24' }}" data-zoom="{{ section.settings.map_zoom | default: 12 }}" data-t-all="{{ 'gymmap.all' | t }}" data-t-req="{{ 'gymmap.request' | t }}" data-t-near-fail="{{ 'gymmap.near_fail' | t }}" data-t-approx="{{ 'gymmap.approx' | t }}">
        <div class="gy__canvas" data-gymmap-canvas role="application" aria-label="{{ tx_mb | escape }}"></div>
        <div class="gy__mapui">
          {%- if tx_mb != blank -%}<button class="gy__mapbtn" type="button" data-gymmap-near>{{ tx_mb }}</button>{%- endif -%}
          <button class="gy__mapall" type="button" data-gymmap-all hidden>{{ 'gymmap.all' | t }}</button>
        </div>
        {%- if tx_zone != blank -%}<span class="gy__zone"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>{{ tx_zone }}</span>{%- endif -%}
        {%- capture gm_json -%}[
          {%- assign gm_first = true -%}
          {%- for block in section.blocks -%}
            {%- assign gm_nm = block.settings.name | split: '|' -%}
            {%- assign gm_chain = gm_nm | join: ' ' | strip -%}
            {%- assign gm_lines = block.settings.locations | newline_to_br | split: '<br />' -%}
            {%- for gm_ln in gm_lines -%}{%- assign gm_f = gm_ln | split: '|' -%}
              {%- if gm_f.size >= 4 -%}{%- unless gm_first -%},{%- endunless -%}{%- assign gm_first = false -%}{"chain":{{ gm_chain | json }},"sede":{{ gm_f[0] | strip | json }},"zone":{{ gm_f[1] | strip | json }},"lat":{{ gm_f[2] | strip | plus: 0 }},"lng":{{ gm_f[3] | strip | plus: 0 }},"addr":{{ gm_f[4] | strip | json }}}{%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        ]{%- endcapture -%}
        <script type="application/json" data-gymmap-data>{{ gm_json }}</script>
      </div>
    </div>

    <div class="gy__sedes" data-gymmap-list>
      <h3 class="gy__sedes-t">{{ 'gymmap.title' | t }}</h3>
      <ul>
        {%- for block in section.blocks -%}
          {%- assign gm_nm = block.settings.name | split: '|' -%}{%- assign gm_chain = gm_nm | join: ' ' | strip -%}
          {%- assign gm_lines = block.settings.locations | newline_to_br | split: '<br />' -%}
          {%- for gm_ln in gm_lines -%}{%- assign gm_f = gm_ln | split: '|' -%}
            {%- if gm_f.size >= 4 -%}<li data-chain="{{ gm_chain | escape }}" data-lat="{{ gm_f[2] | strip }}" data-lng="{{ gm_f[3] | strip }}"><button type="button" data-gymmap-focus><b>{{ gm_chain }}</b><span>{{ gm_f[0] | strip }} · {{ gm_f[1] | strip }}</span></button></li>{%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="gy__label"><span>{{ tx_lt }}</span></div>
    <div class="gy__grid">
      <ul class="gy__logos">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- assign nm = bs.name | split: '|' -%}
          {%- assign nm_a = nm[0] | strip -%}{%- assign nm_b = nm[1] | strip -%}
          {%- assign nm_full = nm_a -%}{%- if nm_b != blank -%}{%- assign nm_full = nm_a | append: ' ' | append: nm_b -%}{%- endif -%}
          <li {{ block.shopify_attributes }}>
            <a class="gy__logo gy__logo--{{ bs.style | default: 'stack' }}" data-gymmap-chain="{{ nm_full | escape }}" href="{{ bs.link | default: 'dialog:sede~' }}{%- if bs.link == blank -%}{{ nm_full }}{%- endif -%}" aria-label="{{ nm_full | escape }}">
              {%- if bs.image != blank -%}
                <img src="{{ bs.image | image_url: width: 300 }}" alt="{{ nm_full | escape }}" loading="lazy" width="150" height="60">
              {%- else -%}
                {%- case bs.glyph -%}
                  {%- when 'ring' -%}<svg class="gy__glyph" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="16" fill="#fff"/><path d="M12 24c6 6 16 2 16-4s-12-2-12-8 8-4 12 0" fill="none" stroke="#111" stroke-width="3.2" stroke-linecap="round"/></svg>
                  {%- when 'shield' -%}<svg class="gy__glyph" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 3l14 5v11c0 9-6 15-14 18C12 34 6 28 6 19V8z" fill="#fff"/><path d="M13 14h14M13 20h11M13 26h14" stroke="#111" stroke-width="3" stroke-linecap="round"/></svg>
                  {%- when 'crown' -%}<svg class="gy__glyph gy__glyph--top" viewBox="0 0 40 24" aria-hidden="true"><path d="M3 20l3-14 8 8 6-11 6 11 8-8 3 14z" fill="#fff"/></svg>
                  {%- when 'bolt' -%}<svg class="gy__glyph" viewBox="0 0 40 40" aria-hidden="true"><path d="M5 30l8-22 4 10 6-14 4 9 8-3-9 22-5-9-6 12-4-9z" fill="#fff"/></svg>
                  {%- when 'p' -%}<svg class="gy__glyph" viewBox="0 0 40 40" aria-hidden="true"><path d="M6 34V8h18a9 9 0 0 1 0 18H16v8z" fill="#fff"/></svg>
                {%- endcase -%}
                <span class="gy__wm">
                  <b>{{ nm_a }}</b>{%- if nm_b != blank -%}<b class="gy__wm2">{{ nm_b }}</b>{%- endif -%}
                  {%- if bs.sub != blank -%}<small>{{ bs.sub }}</small>{%- endif -%}
                </span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
      <aside class="gy__affil tone-dark">
        {%- if tx_at != blank -%}<span class="gy__atag">{{ tx_at }}</span>{%- endif -%}
        <p class="gy__ah"><strong>{{ tx_ah }}</strong>{%- if tx_ax != blank %} {{ tx_ax }}{% endif -%}</p>
        {%- if tx_ab != blank -%}<a class="gy__btn gy__btn--solid" href="{{ section.settings.affil_link | default: 'dialog:gimnasio~Agendar reunión' }}">{{ tx_ab }}</a>{%- endif -%}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gimnasios hermanos",
  "settings": [
    { "type": "text", "id": "tag", "label": "Etiqueta", "default": "Gimnasios hermanos · Red estratégica" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Alianzas que impulsan" },
    { "type": "text", "id": "heading_em", "label": "Título (parte resaltada en naranja)", "default": "tu rendimiento." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Más de 15 gimnasios partners unidos por una misma visión de comunidad y alto desempeño. Además de nuestro servicio a domicilio, puedes elegir cualquiera de estas sedes como punto de entrega para recoger tus pedidos Kulinaria." },
    { "type": "text", "id": "btn1_label", "label": "Botón 1", "default": "Explorar sedes" },
    { "type": "text", "id": "btn1_link", "label": "Botón 1: enlace", "info": "Una página (/pages/...) o dialog:tipo~detalle para abrir un formulario." },
    { "type": "text", "id": "btn2_label", "label": "Botón 2", "default": "Afiliar gimnasio" },
    { "type": "text", "id": "btn2_link", "label": "Botón 2: enlace" },
    { "type": "text", "id": "map_button", "label": "Botón del mapa", "default": "Buscar sede en mi zona" },
    { "type": "text", "id": "map_link", "label": "Botón del mapa: enlace" },
    { "type": "text", "id": "zone", "label": "Zona mostrada en el mapa", "default": "Lomas de Angelópolis" },
    { "type": "text", "id": "map_lat", "label": "Mapa: latitud del centro", "default": "19.03" },
    { "type": "text", "id": "map_lng", "label": "Mapa: longitud del centro", "default": "-98.24" },
    { "type": "range", "id": "map_zoom", "label": "Mapa: zoom inicial", "min": 9, "max": 15, "step": 1, "default": 12 },
    { "type": "text", "id": "logos_title", "label": "Título sobre los logos", "default": "Nuestra red de gimnasios" },
    { "type": "text", "id": "affil_tag", "label": "Tarjeta de afiliación: etiqueta", "default": "Afilia tu gimnasio" },
    { "type": "text", "id": "affil_title", "label": "Tarjeta de afiliación: título", "default": "Afilia tu gimnasio" },
    { "type": "text", "id": "affil_text", "label": "Tarjeta de afiliación: texto", "default": "¿Dueño o gerente? Suma tu sede a la red Kulinaria." },
    { "type": "text", "id": "affil_btn", "label": "Tarjeta de afiliación: botón", "default": "Agendar reunión" },
    { "type": "text", "id": "affil_link", "label": "Tarjeta de afiliación: enlace" }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "gym",
      "name": "Gimnasio",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "info": "Usa | para dos renglones: Sports|World", "default": "Sports|World" },
        { "type": "text", "id": "sub", "label": "Línea pequeña (opcional)" },
        { "type": "textarea", "id": "locations", "label": "Sedes en el mapa (una por línea)", "info": "Formato: Sede | Zona | latitud | longitud | dirección. Para obtener las coordenadas: en Google Maps, clic derecho sobre el lugar y toca los números que aparecen." },
        { "type": "select", "id": "style", "label": "Estilo del logo", "default": "stack", "options": [
          { "value": "stack", "label": "Dos renglones" },
          { "value": "italic", "label": "Cursiva" },
          { "value": "lower", "label": "Minúsculas" },
          { "value": "crown", "label": "Con corona" },
          { "value": "plain", "label": "Una línea" }
        ] },
        { "type": "select", "id": "glyph", "label": "Ícono", "default": "none", "options": [
          { "value": "none", "label": "Ninguno" },
          { "value": "ring", "label": "Aro" },
          { "value": "shield", "label": "Escudo" },
          { "value": "crown", "label": "Corona" },
          { "value": "bolt", "label": "Rayo" },
          { "value": "p", "label": "P" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Logo real (opcional)", "info": "Si subes el logo oficial reemplaza al texto." },
        { "type": "text", "id": "link", "label": "Enlace (vacío = elegir esta sede)" }
      ]
    }
  ],
  "presets": [{ "name": "Gimnasios hermanos" }]
}
{% endschema %}
