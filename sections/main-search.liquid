{%- paginate search.results by 24 -%}
<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__head">
      <span class="eyebrow">{{ 'general.search' | t }}</span>
      <h1 style="font-size:clamp(2.2rem,4vw,3.4rem)">{% if search.performed %}{{ 'search.results_for' | t }}{{ search.terms | escape }}"{% else %}{{ 'general.search' | t }}{% endif %}</h1>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="btn-row" style="margin-bottom:var(--space-xl)">
      <input class="input" style="max-width:420px" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'general.search' | t }}">
      <input type="hidden" name="type" value="product">
      <button class="btn btn--gold" type="submit">{{ 'general.search' | t }}</button>
    </form>
    {%- if search.performed -%}
      {%- if search.results.size == 0 -%}
        <p class="alert">{{ 'search.none' | t }}</p>
      {%- else -%}
        <div class="dish-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}{% render 'dish-card', product: item %}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Búsqueda", "settings": [] }
{% endschema %}
