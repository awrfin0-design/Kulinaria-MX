<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'es' }}" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#EEE6DA">
    <script>
      /* Runs before first paint: theme (light on desktop and dark on phones by default; Day / Night / Fuego; remembers the visitor's choice), loader (once per session) and the motion failsafe. */
      (function () {
        var d = document.documentElement, theme = 'light', seen = false;
        try { theme = localStorage.getItem('kx-theme') || (window.matchMedia && matchMedia('(max-width:760px)').matches ? 'dark' : 'light'); seen = !!sessionStorage.getItem('kx-seen'); } catch (e) {}
        d.setAttribute('data-theme', theme === 'dark' || theme === 'fuego' ? theme : 'light');
        d.className += ' js' + (seen ? ' is-loaded' : ' has-loader');
        setTimeout(function () { d.classList.add('is-loaded'); }, 4500);
        setTimeout(function () { if (!d.classList.contains('motion-ready')) d.classList.add('no-motion'); }, 6000);
      })();
    </script>
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Alegreya+Sans:wght@500;700&family=Kaushan+Script&family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">

    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:url" content="{{ canonical_url }}">
    {%- if page_image -%}<meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">{%- endif -%}

    {{ 'kulinaria.css' | asset_url | stylesheet_tag }}
    <script>
      window.KULINARIA = {
        timezone: {{ settings.timezone | default: 'America/Mexico_City' | json }},
        cutoffHour: {{ settings.cutoff_hour | default: 10 | json }},
        lang: {{ request.locale.iso_code | default: 'es' | json }},
        routes: { cart: {{ routes.cart_url | json }}, cartAdd: {{ routes.cart_add_url | json }}, account: {{ routes.account_url | json }} },
        media: { fire: {{ 'video-fire.mp4' | asset_url | json }} },
        logos: { fuego: {{ 'logo-fuego.webp' | asset_url | json }}, ink: {{ 'logo-black.webp' | asset_url | json }}, cream: {{ 'logo-cream.webp' | asset_url | json }}, gold: {{ 'logo.webp' | asset_url | json }} },
        i18n: {
          pauseLeft: {{ 'js.pause_left' | t | json }}, compat: {{ 'js.compat' | t | json }},
          notSuitable: {{ 'js.not_suitable' | t | json }}, dislikeHit: {{ 'js.dislike_hit' | t | json }},
          remove: {{ 'js.remove' | t | json }}, d: {{ 'js.days' | t | json }}, h: {{ 'js.hours' | t | json }}, min: {{ 'js.minutes' | t | json }},
          toDark: {{ 'theme.to_dark' | t | json }}, toLight: {{ 'theme.to_light' | t | json }},
          pause: {{ 'media.pause' | t | json }}, play: {{ 'media.play' | t | json }}
        }
      };
    </script>
    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handleize }}">
    <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>

    <div class="loader" id="loader" role="status" aria-label="{{ 'loader.label' | t }}">
      <div class="loader__inner">
        <div class="loader__stage" aria-hidden="true">
          <span class="loader__orbit loader__orbit--a"><svg viewBox="0 0 24 24"><path d="M12 2C6 6 4 12 6 20c8-1 14-7 14-14-3-1-6-.7-8-4z" fill="currentColor"/></svg></span>
          <span class="loader__orbit loader__orbit--b"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="currentColor" opacity=".5"/></svg></span>
          <span class="loader__orbit loader__orbit--c"><svg viewBox="0 0 24 24"><path d="M12 2c1 6 8 8 8 15a8 8 0 0 1-16 0c0-3 2-5 3.500-7 .5 2 1.500 3 3 3.500C9.500 8.500 10.500 5 12 2z" fill="currentColor"/></svg></span>
          <span class="loader__ring"><i></i>{% render 'logo', mark: true %}</span>
        </div>
        <p class="loader__tag">{{ 'loader.tagline' | t }}</p>
        <span class="loader__bar" aria-hidden="true"><i data-loader-bar></i></span>
        <span class="loader__pct" aria-hidden="true"><b data-loader-pct>0</b>%</span>
      </div>
    </div>

    <div class="bg-fx" aria-hidden="true"><canvas data-particles></canvas></div>

    {% sections 'header-group' %}

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%} Phone-only bottom sheet explaining the 4-week block pricing; opened by the glowing "i" buttons ([data-sheet="pricing"]). {%- endcomment -%}
    <div class="sheet" id="sheet-pricing" role="dialog" aria-modal="true" aria-labelledby="sheet-pricing-t" aria-hidden="true" data-sheet-root>
      <div class="sheet__backdrop" data-sheet-close></div>
      <div class="sheet__panel" tabindex="-1">
        <span class="sheet__grip" aria-hidden="true"></span>
        <p class="sheet__kicker">{{ 'sheet.info' | t }}</p>
        <h2 id="sheet-pricing-t">{{ 'sheet.title' | t }}</h2>
        <ol class="sheet__steps">
          <li><b>{{ 'sheet.p1_t' | t }}</b><span>{{ 'sheet.p1' | t }}</span></li>
          <li><b>{{ 'sheet.p2_t' | t }}</b><span>{{ 'sheet.p2' | t }}</span>
            <dl class="sheet__tiers">
              <div><dt>{{ 'tier.selecto' | t }}</dt><dd>${{ settings.price_selecto | default: 160 }}</dd></div>
              <div><dt>{{ 'tier.exclusivo' | t }}</dt><dd>${{ settings.price_exclusivo | default: 220 }}</dd></div>
              <div><dt>{{ 'tier.signature' | t }}</dt><dd>${{ settings.price_signature | default: 280 }}</dd></div>
              <div><dt>{{ 'tier.reserve' | t }}</dt><dd>${{ settings.price_reserve | default: 340 }}</dd></div>
            </dl>
            <small>{{ 'sheet.per_dish' | t }}</small>
          </li>
          <li><b>{{ 'sheet.p3_t' | t }}</b><span>{{ 'sheet.p3' | t }}</span></li>
          <li><b>{{ 'sheet.p4_t' | t }}</b><span>{{ 'sheet.p4' | t: pct: settings.trial_markup | default: 15 }}</span></li>
        </ol>
        <button class="btn btn--gold btn--block" type="button" data-sheet-close>{{ 'sheet.close' | t }}</button>
      </div>
    </div>

    {%- if customer -%}
      <script type="application/json" id="kulinaria-customer">
        {
          "allergies": {{ customer.metafields.kulinaria.allergies.value | json }},
          "dislikes": {{ customer.metafields.kulinaria.dislikes.value | json }}
        }
      </script>
    {%- endif -%}
    <script src="{{ 'kulinaria.js' | asset_url }}" defer></script>
  </body>
</html>
