{%- comment -%}
  Menu links that point to the old classic-account addresses (/account/login, /account/register, /account/addresses) 404 with the new customer accounts.
  They are swapped for Shopify's real sign-in / create-account address (which comes back to our welcome page). Any other link is printed unchanged.
  Param: u (the link address)
{%- endcomment -%}
{%- liquid
  if u contains '/account/login'
    render 'login-url', back: '/pages/bienvenida'
  elsif u contains '/account/register'
    render 'login-url', kind: 'register', back: '/pages/bienvenida'
  elsif u contains '/pages/cuenta-perfil'
    echo '/pages/bienvenida?edit=1'
  elsif u contains '/account/addresses' or u == '/account'
    echo '/pages/cuenta'
  else
    echo u
  endif
-%}
