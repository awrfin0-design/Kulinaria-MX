{%- comment -%}
  Dish tile used inside the order funnel (steps 2 and 4). Same data attributes as dish-card so allergy blocking applies.
  Param: product
{%- endcomment -%}
{%- capture mw_state -%}{% render 'menu-week', product: product %}{%- endcapture -%}
{%- if show_all or mw_state == 'on' -%}
{%- liquid
  assign mf = product.metafields.kulinaria
  assign card_src = mf.card_description.value | default: product.description
  assign tier = mf.tier.value | default: 'selecto'
  assign category = mf.category.value | default: product.type | handleize
  assign allergens = mf.allergens.value | join: '|'
  assign ingredients = mf.ingredients.value | join: '|'
  assign diets = mf.diets.value | join: '|'
-%}
{%- capture tx_ptitle -%}{% render 'tx', s: product.title %}{%- endcapture -%}{%- capture tx_pdesc -%}{% render 'tx', s: card_src %}{%- endcapture -%}
{%- assign card_text = tx_pdesc | strip_html | truncate: 90 -%}
<article class="fn-dish" data-dish data-has-detail data-fn-dish data-pid="{{ product.id }}" data-handle="{{ product.handle }}"
  data-title="{{ product.title | escape }}" data-label="{{ tx_ptitle | escape }}" data-category="{{ category }}" data-tier="{{ tier }}" data-diets="{{ diets }}" data-allergens="{{ allergens | escape }}" data-ingredients="{{ ingredients | escape }}">
  <div class="fn-dish__media">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 360, 480', sizes: '(min-width: 1100px) 22vw, 46vw', alt: tx_ptitle }}
    {%- else -%}
      <span class="dish__ph" aria-hidden="true">{% render 'dish-placeholder', category: category %}</span>
    {%- endif -%}
    <span class="fn-count" data-fn-count hidden></span>
    <div class="dish__blocked" role="note"><div><strong>{{ 'dish.blocked_title' | t }}</strong>{{ 'dish.blocked_text' | t }}</div></div>
  </div>
  <span class="fn-up" data-fn-up hidden></span>
  {% render 'dish-detail', product: product %}
  <div class="fn-dish__body">
    {% render 'tier-badge', tier: tier %}
    <h3 class="fn-dish__title">{{ tx_ptitle }}</h3>
    {%- if card_text != blank -%}<p class="dish__desc">{{ card_text }}</p>{%- endif -%}
    {%- if mf.calories.value or mf.carbs.value -%}
      <p class="dish__facts">{%- if mf.calories.value %}{{ mf.calories.value }} kcal{% endif -%}{%- if mf.calories.value and mf.carbs.value %} · {% endif -%}{%- if mf.carbs.value %}{{ mf.carbs.value }} {{ 'dish.carbs_g' | t }}{% endif -%}</p>
    {%- endif -%}
    <p class="fn-warn" data-fn-warn hidden role="note"></p>
    <span class="compat" data-compat></span>
    <div class="fn-dish__row">
      <span class="dish__price">{% render 'plan-price', tier: tier, kind: 'meal', money: true %}<small> {{ 'funnel.per_meal' | t }}</small></span>
      <button class="btn btn--outline btn--sm fn-add" type="button" data-add data-pick>{{ 'funnel.pick' | t }}</button>
    </div>
  </div>
</article>
{%- endif -%}
