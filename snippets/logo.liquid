{%- comment -%}
  Official Kulinaria logo artwork (transparent PNG, extracted from the brand PDF).
  Params:
    tone: 'gold' (default, full colour) | 'cream' | 'black' | 'auto' (ink on the light theme, gold on dark)  -> logo.png / logo-cream.png / logo-black.png
    mark: true -> the K + flame monogram only (logo-mark.png)
    height: optional CSS height (e.g. '56px'); width follows the artwork ratio
  Replace the files in /assets (same names) with the high-resolution originals when available.
{%- endcomment -%}
{%- liquid
  assign tone_key = tone | default: 'gold'
  if mark
    assign file = 'logo-mark.png'
    assign w = 356
    assign h = 363
  else
    case tone_key
      when 'cream'
        assign file = 'logo-cream.png'
      when 'black'
        assign file = 'logo-black.png'
      else
        assign file = 'logo.png'
    endcase
    assign w = 817
    assign h = 399
  endif
-%}
{%- if tone_key == 'auto' and mark != true -%}
  {%- assign alt_text = shop.name | default: 'Kulinaria' | append: ', ' | append: settings.brand_tagline | default: 'Arte del fuego' -%}
  <img class="logo logo--ink" src="{{ 'logo-black.png' | asset_url }}" width="817" height="399" alt="{{ alt_text | escape }}" decoding="async">
  <img class="logo logo--gold" src="{{ 'logo.png' | asset_url }}" width="817" height="399" alt="" aria-hidden="true" decoding="async">
{%- else -%}
<img class="logo{% if mark %} logo--mark{% endif %}" src="{{ file | asset_url }}" width="{{ w }}" height="{{ h }}"
  alt="{% if mark %}{{ shop.name | default: 'Kulinaria' }}{% else %}{{ shop.name | default: 'Kulinaria' }}, {{ settings.brand_tagline | default: 'Arte del fuego' }}{% endif %}"
  {%- if height %} style="height:{{ height }};width:auto"{% endif %} decoding="async">
{%- endif -%}
