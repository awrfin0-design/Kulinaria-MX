{%- comment -%} Shown to a signed-in customer until the onboarding questionnaire is done (the script hides it once the profile exists). {%- endcomment -%}
{%- if customer -%}
<section class="hub__card hub__card--onb" data-onb-banner hidden>
  <h3>{{ 'acct.onb_t' | t }}</h3>
  <p class="text-muted">{{ 'acct.onb_p' | t }}</p>
  <div class="btn-row"><a class="btn btn--gold btn--sm" href="/pages/bienvenida">{{ 'acct.onb_cta' | t }}</a></div>
</section>
{%- endif -%}
