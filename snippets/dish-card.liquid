{%- comment -%}
  Dish card used in the weekly menu grid, home preview and related dishes.
  Param: product
  Metafields (namespace "kulinaria"):
    tier (single line: selecto|exclusivo|signature|reserve)
    category (single line slug, e.g. al-fuego-y-mar)
    allergens (list of single line text), ingredients (list), diets (list of slugs)
    calories (integer), carbs (integer, grams)
  One top-down plated photo only — never multiple preparation methods.
{%- endcomment -%}
{%- capture mw_state -%}{% render 'menu-week', product: product %}{%- endcapture -%}
{%- if show_all or mw_state == 'on' -%}
{%- liquid
  assign mf = product.metafields.kulinaria
  assign card_src = mf.card_description.value | default: product.description
  assign tier = mf.tier.value | default: 'selecto'
  assign category = mf.category.value | default: product.type | handleize
  assign allergens = mf.allergens.value | join: '|'
  assign ingredients = mf.ingredients.value | join: '|'
  assign diets = mf.diets.value | join: '|'
-%}
{%- capture tx_ptitle -%}{% render 'tx', s: product.title %}{%- endcapture -%}{%- capture tx_pdesc -%}{% render 'tx', s: card_src %}{%- endcapture -%}
{%- assign card_text = tx_pdesc | strip_html | truncate: 90 -%}
<article class="dish" data-dish
  data-category="{{ category }}" data-tier="{{ tier }}"
  data-diets="{{ diets }}" data-allergens="{{ allergens | escape }}" data-ingredients="{{ ingredients | escape }}">
  <a class="dish__media surface-walnut" data-tilt-card href="{{ product.url }}" aria-label="{{ tx_ptitle | escape }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 1100px) 25vw, 50vw', alt: tx_ptitle }}
    {%- else -%}
      <span class="dish__ph surface-slate" aria-hidden="true">{% render 'dish-placeholder', category: category %}</span>
    {%- endif -%}
    <span class="dish__pill" aria-hidden="true">{{ 'dish.view' | t }}</span>
  </a>
  <div class="dish__body">
    <div>{% render 'tier-badge', tier: tier %}</div>
    <h3 class="dish__title"><a href="{{ product.url }}">{{ tx_ptitle }}</a></h3>
    {%- if card_text != blank -%}<p class="dish__desc">{{ card_text }}</p>{%- endif -%}
    {%- if mf.calories.value or mf.carbs.value -%}
      <p class="dish__facts">
        {%- if mf.calories.value %}{{ mf.calories.value }} kcal{% endif -%}
        {%- if mf.calories.value and mf.carbs.value %} · {% endif -%}
        {%- if mf.carbs.value %}{{ mf.carbs.value }} {{ 'dish.carbs_g' | t }}{% endif -%}
      </p>
    {%- endif -%}
    <span class="compat" data-compat></span>
    <p class="fn-warn" data-fn-warn hidden role="note"></p>
    <div class="dish__meta">
      <span class="dish__price">{% render 'plan-price', tier: tier, kind: 'meal', money: true %}<small> {{ 'funnel.per_meal' | t }}</small></span>
      <a class="dish__go" href="{{ product.url }}" aria-label="{{ 'dish.view_of' | t }} {{ tx_ptitle | escape }}">→</a>
    </div>
  </div>
  <div class="dish__blocked" role="note"><div><strong>{{ 'dish.blocked_title' | t }}</strong>{{ 'dish.blocked_text' | t }}</div></div>
</article>
{%- endif -%}
