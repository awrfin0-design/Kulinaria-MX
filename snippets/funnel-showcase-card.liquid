{%- comment -%}
  Read-only dish card for step 2 of the order funnel ("discover the menu"). Same anatomy as the menu page card: photo, tier, name, description, kcal and carbs, price and an arrow. Nothing to pick here.
  Param: product
{%- endcomment -%}
{%- capture mw_state -%}{% render 'menu-week', product: product %}{%- endcapture -%}
{%- if show_all or mw_state == 'on' -%}
{%- liquid
  assign mf = product.metafields.kulinaria
  assign card_src = mf.card_description.value | default: product.description
  assign tier = mf.tier.value | default: 'selecto'
-%}
{%- capture tx_ptitle -%}{% render 'tx', s: product.title %}{%- endcapture -%}{%- capture tx_pdesc -%}{% render 'tx', s: card_src %}{%- endcapture -%}
<article class="fn-sc">
  <div class="fn-sc__img">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '210, 320, 420', sizes: '(min-width: 1100px) 14vw, 60vw', alt: tx_ptitle }}
    {%- else -%}
      <span class="dish__ph" aria-hidden="true">{% render 'dish-placeholder', category: mf.category.value | default: product.type | handleize %}</span>
    {%- endif -%}
  </div>
  <div class="fn-sc__body">
    {% render 'tier-badge', tier: tier %}
    <h3>{{ tx_ptitle }}</h3>
    {%- if tx_pdesc != blank -%}<p class="fn-sc__desc">{{ tx_pdesc | strip_html | truncate: 110 }}</p>{%- endif -%}
    {%- if mf.calories.value or mf.carbs.value -%}<p class="fn-sc__facts">{%- if mf.calories.value %}{{ mf.calories.value }} kcal{% endif -%}{%- if mf.calories.value and mf.carbs.value %} · {% endif -%}{%- if mf.carbs.value %}{{ mf.carbs.value }} {{ 'dish.carbs_g' | t }}{% endif -%}</p>{%- endif -%}
    <div class="fn-sc__row"><span class="fn-sc__price">{% render 'plan-price', tier: tier, kind: 'meal', money: true %}<small> {{ 'funnel.per_meal' | t }}</small></span><span class="fn-sc__go" aria-hidden="true">&rarr;</span></div>
  </div>
</article>
{%- endif -%}
