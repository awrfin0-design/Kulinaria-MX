  {
    "name": "Ciclo semanal",
    "settings": [
      {
        "type": "header",
        "content": "Cierre de pedidos y pausas"
      },
      {
        "type": "paragraph",
        "content": "El ciclo inicia el sábado a la hora de cierre. Las pausas se bloquean el martes 10:00 AM (entregas jueves y viernes) y el viernes 7:00 PM (entregas lunes a miércoles)."
      },
      {
        "type": "text",
        "id": "timezone",
        "label": "Zona horaria (IANA)",
        "default": "America/Mexico_City"
      },
      {
        "type": "range",
        "id": "cutoff_hour",
        "label": "Hora de cierre (sábado)",
        "min": 0,
        "max": 23,
        "step": 1,
        "default": 10
      },
      {
        "type": "text",
        "id": "pause_locked_message",
        "label": "Mensaje de pausa bloqueada",
        "default": "Tiempo límite de pausa agotado para el siguiente periodo"
      },
      {
        "type": "url",
        "id": "subscription_portal_url",
        "label": "Portal de suscripciones (pausar / reanudar)",
        "info": "URL del portal del cliente de tu app de suscripciones (Shopify Subscriptions, Recharge, Seal, etc.)."
      }
    ]
  },
  {
